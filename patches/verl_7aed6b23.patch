+# Same semantic keys as ``AgentLoopManager._performance_metrics`` (agent_loop.py).
+_AGENT_LOOP_STANDARD_METRIC_KEYS = frozenset(
+    {"generate_sequences", "tool_calls", "compute_score", "num_preempted"}
