diff --git a/verl/utils/episode_segments.py b/verl/utils/episode_segments.py
new file mode 100644
index 0000000..805e346
--- /dev/null
+++ b/verl/utils/episode_segments.py
@@ -0,0 +1,212 @@
+"""Episode envelopes for context-preserving, multi-segment agent rollouts.
+
+Rollout/validation keep one row per task execution. Only training expands the
+segments. Query ids define GRPO groups; episode ids deduplicate outcomes within
+those groups. Updates and sequence-loss normalization count original episodes;
+GSPO importance ratios and clipping still operate on individual segments.
+"""
+
+from math import lcm
+from uuid import uuid4
+
+import numpy as np
+import torch
+
+from verl import DataProto
+from verl.utils.seqlen_balancing import calculate_workload, get_seqlen_balanced_partitions
+
+SEGMENTS_KEY = "_episode_segments"
+PADDING_KEY = "segment_padding"
+EPISODE_INDEX = "episode_index"
+TOKEN_COUNT = "episode_token_count"
+
+
+def validate_episode_training(config):
+    """Fail explicitly for training paths that do not honor episode boundaries."""
+    actor = config.actor_rollout_ref.actor
+    if config.algorithm.adv_estimator != "grpo" or config.algorithm.get("use_kl_in_reward", False):
+        raise ValueError("trajectory_selection=all requires GRPO and use_kl_in_reward=false")
+    if actor.strategy not in {"fsdp", "fsdp2", "veomni"}:
+        raise ValueError("trajectory_selection=all currently supports the FSDP and VeOmni engines")
+    if actor.get("use_prefix_grouper", False):
+        raise ValueError("Multi-segment episodes do not support prefix-group batch balancing")
+    if config.trainer.get("use_legacy_worker_impl", "disable") != "disable":
+        raise ValueError("trajectory_selection=all requires trainer.use_legacy_worker_impl=disable")
+    if (config.get("distillation") or {}).get("enabled", False):
+        raise ValueError("Multi-segment episodes do not support distillation")
+
+
+def pad_segments(data: DataProto, divisor: int) -> DataProto:
+    """Pad dispatch rows without creating outcomes, loss tokens or episodes."""
+    n_pad = (-len(data)) % divisor
+    if not n_pad:
+        return data
+    # Reuse the shortest forward input. A masked row still participates in DP
+    # collectives, including on ranks with no real segments in this update.
+    shortest = int(data.batch["attention_mask"].sum(-1).argmin())
+    pad = data.select_idxs(np.full(n_pad, shortest, dtype=np.int64))
+    pad.batch = pad.batch.clone()
+    pad.batch[PADDING_KEY].fill_(True)
+    for key in ("response_mask", "rm_scores", "token_level_scores", "token_level_rewards", "advantages", "returns"):
+        if key in pad.batch:
+            pad.batch[key].zero_()
+    # concat merges metadata; it must not concatenate rollout metrics again.
+    metadata = dict(data.meta_info)
+    data.meta_info = {}
+    pad.meta_info = {}
+    result = DataProto.concat([data, pad])
+    data.meta_info = metadata
+    result.meta_info = metadata
+    return result
+
+
+def _forward_batch_divisor(config):
+    # The actual DP size can be smaller than world size (e.g. Ulysses SP).
+    # This conservative multiple also supports fixed-size inference batches.
+    divisor = int(config.trainer.nnodes * config.trainer.n_gpus_per_node)
+    micro_sizes = [1]
+    for name in ("rollout", "ref"):
+        cfg = config.actor_rollout_ref.get(name, {})
+        if not cfg.get("log_prob_use_dynamic_bsz", True):
+            size = cfg.get("log_prob_micro_batch_size_per_gpu")
+            if size is None or size < 1:
+                raise ValueError(f"{name}.log_prob_micro_batch_size_per_gpu must be positive for fixed batching")
+            micro_sizes.append(int(size))
+    return divisor * lcm(*micro_sizes)
+
+
+def expand_episode_segments(data: DataProto, config) -> DataProto:
+    envelopes = data.non_tensor_batch.pop(SEGMENTS_KEY, None)
+    selections = data.non_tensor_batch.get("trajectory_selection", [])
+    has_segments = envelopes is not None and any(e is not None for e in envelopes)
+    if not has_segments and not any(s == "all" for s in selections):
+        return data
+    validate_episode_training(config)
+
+    rows = []
+    for i in range(len(data)):
+        parent = data[i : i + 1]
+        episode_id = parent.non_tensor_batch.get("episode_id", [None])[0] or f"empty-{uuid4().hex}"
+        parent.non_tensor_batch["episode_id"] = np.array([episode_id], dtype=object)
+        parent.batch[EPISODE_INDEX] = torch.tensor([i], dtype=torch.long)
+        parent.meta_info = {}
+        rows.append(parent)
+        extra = envelopes[i] if envelopes is not None else None
+        if extra is None:
+            continue
+        for j in range(len(extra)):
+            child = extra[j : j + 1]
+            # Keep input metadata assigned after rollout (notably async uid).
+            # Child tensor fields and generated metadata describe its own context.
+            tensors = parent.batch.clone()
+            tensors.update(child.batch)
+            metadata = dict(parent.non_tensor_batch)
+            metadata.update(child.non_tensor_batch)
+            metadata.pop(SEGMENTS_KEY, None)
+            metadata["uid"] = parent.non_tensor_batch["uid"].copy()
+            metadata["episode_id"] = parent.non_tensor_batch["episode_id"].copy()
+            rows.append(DataProto(batch=tensors, non_tensor_batch=metadata))
+    expanded = DataProto.concat(rows)
+    expanded.meta_info = dict(data.meta_info)
+    expanded.meta_info["episode_segments_expanded"] = True
+    expanded.meta_info["num_rollout_episodes"] = len(data)
+    expanded.meta_info["num_training_segments"] = len(expanded)
+    expanded.batch[PADDING_KEY] = torch.zeros(len(expanded), dtype=torch.bool)
+    return pad_segments(expanded, _forward_batch_divisor(config))
+
+
+def iter_episode_minibatches(data: DataProto, actor_config, rollout_n: int, dp_size: int):
+    """Select episodes first, then balance/pad their segments for one update.
+
+    The planner is global: no worker-local row shuffle may split an episode
+    across optimizer steps. Physical row counts can vary between updates.
+    Loss denominators are computed after trainer-side filtering and before
+    microbatching; later loss-side rejection does not renormalize them.
+    """
+    groups = {}
+    for row, (episode, padding) in enumerate(
+        zip(data.batch[EPISODE_INDEX].tolist(), data.batch[PADDING_KEY].tolist(), strict=True)
+    ):
+        if not padding:
+            groups.setdefault(episode, []).append(row)
+    episodes = sorted(groups)
+    budget = int(actor_config.ppo_mini_batch_size * rollout_n)
+    if budget < 1 or dp_size < 1:
+        raise ValueError("Episode batch size and DP size must be positive")
+
+    # A denominator per row survives arbitrary DP and microbatch placement.
+    counts = data.batch["response_mask"].sum(-1)
+    denominators = torch.zeros_like(counts)
+    for rows in groups.values():
+        denominators[rows] = counts[rows].sum()
+    data.batch[TOKEN_COUNT] = denominators
+
+    generator = torch.Generator().manual_seed(actor_config.data_loader_seed)
+    plans = []  # indices only, never materialize epochs of token tensors
+    for _ in range(actor_config.ppo_epochs):
+        order = (
+            torch.randperm(len(episodes), generator=generator).tolist()
+            if actor_config.shuffle
+            else range(len(episodes))
+        )
+        ordered = [episodes[i] for i in order]
+        for start in range(0, len(ordered), budget):
+            selected = ordered[start : start + budget]
+            rows = [row for episode in selected for row in groups[episode]]
+            # Skip a globally empty update, never an individual empty rank.
+            if counts[rows].sum() > 0:
+                plans.append((rows, len(selected)))
+
+    micro_size = 1 if actor_config.use_dynamic_bsz else actor_config.ppo_micro_batch_size_per_gpu
+    if micro_size is None or micro_size < 1:
+        raise ValueError("ppo_micro_batch_size_per_gpu must be positive for fixed batching")
+    for step, (rows, episode_count) in enumerate(plans):
+        batch = data.select_idxs(np.asarray(rows, dtype=np.int64))
+        batch.meta_info = dict(data.meta_info)
+        batch = pad_segments(batch, dp_size * int(micro_size))
+        workloads = calculate_workload(batch.batch["attention_mask"].sum(-1)).tolist()
+        partitions = get_seqlen_balanced_partitions(workloads, dp_size, equal_size=True)
+        batch.reorder(torch.tensor([row for partition in partitions for row in partition]))
+        batch.meta_info["num_update_episodes"] = episode_count
+        batch.meta_info["update_lr_scheduler"] = step == len(plans) - 1
+        yield batch
+
+
+def compute_episode_grpo(data, norm_adv_by_std_in_grpo=True):
+    """Compute one outcome advantage per episode and broadcast to its segments.
+
+    Filtered/empty rows never enter the baseline. If a partially truncated
+    episode still has usable segments, it contributes once through those rows.
+    """
+    from verl.trainer.ppo.core_algos import compute_grpo_outcome_advantage
+    from verl.trainer.ppo.trajectory_filter import FILTER_MASK_KEY
+
+    mask = data.batch["response_mask"]
+    invalid = np.asarray(data.non_tensor_batch.get(FILTER_MASK_KEY, np.zeros(len(data), dtype=bool)))
+    padding = data.batch[PADDING_KEY].cpu().numpy()
+    episodes = {}
+    row_episode = {}
+    for i, episode in enumerate(data.non_tensor_batch["episode_id"]):
+        if padding[i] or invalid[i] or not mask[i].any():
+            continue
+        uid = data.non_tensor_batch["uid"][i]
+        reward = float(data.non_tensor_batch["episode_reward"][i])
+        if episode not in episodes:
+            episodes[episode] = (len(episodes), uid, reward)
+        slot, original_uid, original_reward = episodes[episode]
+        if uid != original_uid or reward != original_reward:
+            raise ValueError("Segments in one episode must share query uid and outcome reward")
+        row_episode[i] = slot
+    result = torch.zeros_like(data.batch["token_level_rewards"])
+    if episodes:
+        scores = result.new_tensor([item[2] for item in episodes.values()]).unsqueeze(1)
+        uids = np.array([item[1] for item in episodes.values()], dtype=object)
+        episode_adv, _ = compute_grpo_outcome_advantage(
+            token_level_rewards=scores,
+            response_mask=torch.ones_like(scores),
+            index=uids,
+            norm_adv_by_std_in_grpo=norm_adv_by_std_in_grpo,
+        )
+        for row, slot in row_episode.items():
+            result[row] = episode_adv[slot, 0] * mask[row]
+    return result, result.clone()
