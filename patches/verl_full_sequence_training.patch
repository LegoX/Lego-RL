@@ -0,0 +1,73 @@
+"""Loss-preserving full-sequence layout for text agent training.
+
+The rollout limits remain unchanged. In full-sequence mode the trainer keeps
+one existing prefix token as the causal anchor and puts all remaining tokens
+in the response tensor. Copied context has loss_mask=0. Thus any nonempty-prefix
+sequence within the total budget fits, without moving sampled actions out of
+loss or adding tokens. All workers use the same widths, including empty rows.
+"""
+import os
+
+
+class TrainingSequenceOverflow(ValueError):
+    """A complete sequence exceeds the configured training context window."""
+
+
+def full_sequence_training_enabled():
+    return os.environ.get("VERL_AGENT_FULL_SEQUENCE_TRAINING", "0") == "1"
+
+
+def training_sequence_length(config):
+    columns = int(config.prompt_length) + int(config.response_length)
+    model_limit = getattr(config, "max_model_len", None)
+    budget = min(columns, int(model_limit)) if model_limit is not None else columns
+    if budget < 2:
+        raise ValueError("Full-sequence training requires at least two token positions")
+    return budget
+
+
+def training_tensor_widths(config):
+    if full_sequence_training_enabled():
+        return 1, training_sequence_length(config) - 1
+    return int(config.prompt_length), int(config.response_length)
+
+
+def normalize_training_output(output, config):
+    if not full_sequence_training_enabled():
+        return output
+    if output.multi_modal_data:
+        raise ValueError("Full-sequence agent layout currently supports text trajectories only")
+    prompt = list(output.prompt_ids)
+    response = list(output.response_ids)
+    if not prompt:
+        raise ValueError("Full-sequence training requires an existing causal prefix token")
+    if len(output.response_mask) != len(response):
+        raise ValueError("Training response token/mask lengths differ")
+    if output.response_logprobs is not None and len(output.response_logprobs) != len(response):
+        raise ValueError("Training response token/logprob lengths differ")
+    total = len(prompt) + len(response)
+    limit = training_sequence_length(config)
+    if total > limit:
+        raise TrainingSequenceOverflow(f"Complete training sequence has {total} tokens; limit={limit}")
+    if output.routed_experts is not None and output.routed_experts.shape[0] != total:
+        raise ValueError("Full-sequence routing must cover the original complete token sequence")
+    context = prompt[1:]
+    metrics = output.metrics.model_copy(deep=True)
+    metrics.training_original_prompt_tokens = float(len(prompt))
+    metrics.training_original_response_positions = float(len(response))
+    metrics.training_sequence_tokens = float(total)
+    metrics.training_context_positions = float(len(context))
+    extra = dict(output.extra_fields)
+    extra["training_sequence_layout"] = "full_sequence"
+    extra["training_original_prompt_tokens"] = len(prompt)
+    extra["training_original_response_positions"] = len(response)
+    # Full-sequence IDs and the absolute R3 predictor positions do not move.
+    return output.model_copy(update={
+        "prompt_ids": prompt[:1],
+        "response_ids": context + response,
+        "response_mask": [0] * len(context) + list(output.response_mask),
+        "response_logprobs": None if output.response_logprobs is None else
+            [0.0] * len(context) + list(output.response_logprobs),
+        "metrics": metrics,
+        "extra_fields": extra,
+    })
