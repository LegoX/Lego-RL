@@ -578,6 +578,71 @@ class EngineCore:
             reset_running_requests, reset_connector
         )
 
+    def kv_cache_usage_probe(self) -> dict[str, Any]:
+        """Return current local KV cache occupancy without scheduling a request."""
+        kv_cache_manager = self.scheduler.kv_cache_manager
+        return {
+            "enabled": True,
+            "kv_cache_usage": kv_cache_manager.usage,
+            "num_gpu_blocks": kv_cache_manager.block_pool.num_gpu_blocks,
+        }
+
+    def prefix_cache_probe(self, prompt_token_ids: list[int]) -> dict[str, Any]:
+        """Probe local prefix-cache residency for a prompt without side effects.
+
+        This mirrors the lookup part of ``KVCacheManager.get_computed_blocks()``
+        but intentionally bypasses that helper so ``prefix_cache_stats`` is not
+        updated. The temporary Request is never added to the scheduler.
+        """
+        from vllm import SamplingParams
+
+        kv_cache_manager = self.scheduler.kv_cache_manager
+        prompt_tokens = len(prompt_token_ids)
+
+        if self.request_block_hasher is None:
+            return {
+                "enabled": False,
+                "prompt_tokens": prompt_tokens,
+                "hit_tokens": 0,
+                "hit_ratio": 0.0,
+                "num_block_hashes": 0,
+                "kv_cache_usage": kv_cache_manager.usage,
+            }
+
+        req = Request(
+            request_id="__prefix_cache_probe__",
+            prompt_token_ids=list(prompt_token_ids),
+            sampling_params=SamplingParams(max_tokens=1),
+            pooling_params=None,
+            block_hasher=self.request_block_hasher,
+        )
+
+        if (
+            not kv_cache_manager.enable_caching
+            or req.skip_reading_prefix_cache
+            or prompt_tokens <= 1
+        ):
+            hit_tokens = 0
+        else:
+            # Match scheduler semantics: even if the full prompt is cached, the
+            # last token is recomputed to produce logits.
+            max_cache_hit_length = req.num_tokens - 1
+            _, hit_tokens = (
+                kv_cache_manager.coordinator.find_longest_cache_hit(
+                    req.block_hashes,
+                    max_cache_hit_length,
+                )
+            )
+
+        return {
+            "enabled": True,
+            "prompt_tokens": prompt_tokens,
+            "hit_tokens": hit_tokens,
+            "hit_ratio": hit_tokens / max(1, prompt_tokens),
+            "num_block_hashes": len(req.block_hashes),
+            "kv_cache_usage": kv_cache_manager.usage,
+        }
+
