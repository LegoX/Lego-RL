--- /dev/null
+++ b/tests/unit/test_mean_reward_key.py
@@ -0,0 +1,27 @@
+import pytest
+
+from harbor.metrics.factory import MetricFactory
+from harbor.metrics.mean import Mean
+from harbor.models.metric.type import MetricType
+
+
+def test_mean_selects_primary_reward_and_preserves_diagnostics():
+    rewards = [
+        {"reward": 0, "p2p": 1.0, "partial": 0.5},
+        {"reward": 1, "p2p": 1.0, "partial": 1.0},
+        None,
+    ]
+    metric = MetricFactory.create_metric(MetricType.MEAN, reward_key="reward")
+    assert metric.compute(rewards) == {"mean": 1 / 3}
+    assert rewards[0] == {"reward": 0, "p2p": 1.0, "partial": 0.5}
+
+
+def test_mean_rejects_missing_explicit_key():
+    with pytest.raises(ValueError, match="Missing reward key"):
+        Mean(reward_key="reward").compute([{"partial": 1.0}])
+
+
+def test_default_mean_retains_single_key_contract():
+    assert Mean().compute([{"score": 1}, {"score": 0}]) == {"mean": 0.5}
+    with pytest.raises(ValueError, match="exactly one key"):
+        Mean().compute([{"reward": 0, "partial": 1.0}])
