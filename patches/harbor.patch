+@pytest.mark.asyncio
+@pytest.mark.parametrize("submission,expected", [("committed fix", 1), ("", 0)])
+async def test_actual_verifier_scores_transferred_submission(
+    tmp_path, monkeypatch, submission, expected
+):
+    """Run the real Verifier and a toy grading script using a local fake backend."""
+    task_dir = tmp_path / "task"
+    (task_dir / "environment").mkdir(parents=True)
+    (task_dir / "tests").mkdir()
+    (task_dir / "instruction.md").write_text("Commit a fix.")
+    (task_dir / "environment" / "Dockerfile").write_text("FROM toy:latest\n")
+    (task_dir / "task.toml").write_text(
+        '[environment]\ndocker_image="toy:latest"\n'
+        '[verifier]\nenvironment_mode="separate"\nnetwork_mode="no-network"\n'
+    )
+    script = task_dir / "tests" / "test.sh"
+    script.write_text(
+        "#!/bin/sh\nset -eu\n"
+        'if [ "$(cat "$TOY_ROOT/logs/artifacts/model.patch")" = "committed fix" ]; then reward=1; else reward=0; fi\n'
+        'echo "{\\"reward\\": $reward}" > "$TOY_ROOT/logs/verifier/reward.json"\n'
+        'echo "graded transferred submission"\n'
+    )
+    task = Task(task_dir)
+    config = make_config(tmp_path)
+    config.verifier.allowed_rewards = {"reward": [0, 1]}
+    paths = TrialPaths(tmp_path / "trial")
+    paths.mkdir()
+    artifact = paths.artifacts_dir / "model.patch"
+    artifact.write_text(submission)
+    paths.reward_text_path.write_text("1")
+    root = tmp_path / "fresh-verifier"
+    (root / "logs" / "verifier").mkdir(parents=True)
+    (root / "logs" / "artifacts").mkdir()
+    env = MagicMock(is_mounted=False)
+    env.start = AsyncMock()
+    env.stop = AsyncMock()
+    env.apply_network_policy = AsyncMock()
+    env.run_healthcheck = AsyncMock()
+
+    async def upload_file(source_path, target_path):
+        target = root / target_path.lstrip("/")
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source_path, target)
+
+    async def upload_dir(source_dir, target_dir):
+        shutil.copytree(source_dir, root / target_dir.lstrip("/"), dirs_exist_ok=True)
+
+    async def download_dir(source_dir, target_dir):
+        shutil.copytree(root / source_dir.lstrip("/"), target_dir, dirs_exist_ok=True)
+
+    async def execute(command, **kwargs):
+        command = command.replace("/tests", str(root / "tests")).replace(
+            "/logs", str(root / "logs")
+        )
+        process = await asyncio.create_subprocess_shell(
+            command,
+            env={**os.environ, "TOY_ROOT": str(root)},
+            stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.PIPE,
+        )
+        stdout, stderr = await process.communicate()
+        return ExecResult(
+            return_code=process.returncode,
+            stdout=stdout.decode(),
+            stderr=stderr.decode(),
+        )
+
+    env.upload_file = AsyncMock(side_effect=upload_file)
+    env.upload_dir = AsyncMock(side_effect=upload_dir)
+    env.download_dir = AsyncMock(side_effect=download_dir)
+    env.exec = AsyncMock(side_effect=execute)
+    monkeypatch.setattr(
+        separate.EnvironmentFactory,
+        "create_environment_from_config",
+        lambda **kwargs: env,
+    )
+    result = await separate.verify_separately(
+        task,
+        config,
+        paths,
+        [separate.SubmissionArtifact(artifact, "/logs/artifacts/model.patch", False)],
+        5,
+        logging.getLogger(),
+    )
+    assert result.rewards == {"reward": expected}
+    assert "graded transferred submission" in paths.test_stdout_path.read_text()
+    assert not paths.reward_text_path.exists()
+    env.stop.assert_awaited_once_with(delete=True)
+
