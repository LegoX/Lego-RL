+"""Separate grading must use committed artifacts and an isolated environment."""
+
+import asyncio
+import logging
+import os
+import shutil
+import subprocess
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from harbor.environments.base import ExecResult
+from harbor.models.job.config import RetryConfig
+from harbor.models.task.config import TaskConfig, VerifierConfig
+from harbor.models.task.task import Task
+from harbor.models.trial.config import TrialConfig
+from harbor.models.trial.paths import TrialPaths
+from harbor.models.verifier.result import VerifierResult
+from harbor.trial import separate_verifier as separate
+from harbor.trial.trial import Trial
+from harbor.verifier.verifier import InvalidRewardError, Verifier
+
+
+def make_task(tmp_path, **verifier):
+    cfg = TaskConfig.model_validate(
+        {
+            "environment": {
+                "docker_image": "official:v1.1",
+                "cpus": 4,
+                "memory_mb": 8192,
+                "env": {"BASE": "yes"},
+                "network_mode": "no-network",
+            },
+            "verifier": {
+                "environment_mode": "separate",
+                "environment": {"cpus": 2},
+                **verifier,
+            },
+            "artifacts": ["/logs/artifacts/model.patch"],
+        }
+    )
+    return SimpleNamespace(
+        config=cfg, paths=SimpleNamespace(environment_dir=tmp_path), name="toy"
+    )
+
+
+def make_config(tmp_path):
+    return TrialConfig.model_validate(
+        {
+            "task": {"path": str(tmp_path)},
+            "trial_name": "toy-trial",
+            "environment": {
+                "type": "docker",
+                "override_memory_mb": 512,
+                "kwargs": {
