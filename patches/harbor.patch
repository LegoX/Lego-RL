+@pytest.mark.parametrize("recovers", [True, False])
+async def test_invalid_reward_retries_same_submission_only(
+    tmp_path, monkeypatch, recovers
+):
+    trial = Trial.__new__(Trial)
+    trial._task = make_task(tmp_path)
+    trial.config = make_config(tmp_path)
+    trial.config.verifier.allowed_rewards = {"reward": [0, 1]}
+    trial._trial_paths = TrialPaths(tmp_path / "trial")
+    trial._trial_paths.mkdir()
+    patch = trial._trial_paths.artifacts_dir / "model.patch"
+    patch.write_text("original committed submission")
+    trial._verifier_artifacts = [
+        separate.SubmissionArtifact(patch, "/logs/artifacts/model.patch", False)
+    ]
+    trial._verifier_timeout_sec = 5
+    trial._logger = logging.getLogger()
+    trial._result = SimpleNamespace(verifier_result=None)
+    created = []
+
+    def factory(**kwargs):
+        created.append(kwargs)
+        env = MagicMock(is_mounted=True)
+        env.start = AsyncMock()
+        env.stop = AsyncMock()
+        env.run_healthcheck = AsyncMock()
+        env.apply_network_policy = AsyncMock()
+        env.upload_file = AsyncMock()
+        env.upload_dir = AsyncMock()
+
+        async def execute(command, **kw):
+            if not command.startswith("chmod"):
+                vp = kwargs["trial_paths"]
+                vp.reward_text_path.write_text(
+                    "1" if recovers and len(created) == 2 else "-1"
+                )
+                vp.test_stdout_path.write_text(f"attempt {len(created)}")
+            return ExecResult(return_code=0)
+
+        env.exec = AsyncMock(side_effect=execute)
+        kwargs["fake_env"] = env
+        return env
+
+    trial._task.paths.tests_dir = tmp_path / "tests"
+    trial._task.paths.test_path = trial._task.paths.tests_dir / "test.sh"
+    monkeypatch.setattr(
+        separate.EnvironmentFactory, "create_environment_from_config", factory
+    )
+    if recovers:
+        await trial._verify_with_retry()
+        assert trial.result.verifier_result.rewards == {"reward": 1}
+    else:
+        with pytest.raises(InvalidRewardError):
+            await trial._verify_with_retry()
+        assert trial.result.verifier_result is None
+    assert len(created) == 2
+    assert created[0]["session_id"] != created[1]["session_id"]
+    assert created[0]["trial_paths"].reward_text_path.read_text() == "-1"
+    for attempt in created:
+        attempt["fake_env"].upload_file.assert_awaited_once_with(
+            source_path=patch, target_path="/logs/artifacts/model.patch"
+        )
+        attempt["fake_env"].stop.assert_awaited_once_with(delete=True)
+    assert patch.read_text() == "original committed submission"
+    assert "InvalidRewardError" in RetryConfig().exclude_exceptions
