+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", [None, "start", "verify", "timeout", "cancel"])
+async def test_fresh_verifier_transfer_logs_and_cleanup(tmp_path, monkeypatch, failure):
+    task = make_task(tmp_path)
+    config = make_config(tmp_path)
+    paths = TrialPaths(tmp_path / "trial")
+    paths.mkdir()
+    paths.reward_text_path.write_text("1")  # must not be used as verifier output
+    patch = paths.artifacts_dir / "model.patch"
+    patch.write_text("submitted patch")
+    env = MagicMock(is_mounted=True)
+    env.start = AsyncMock()
+    env.stop = AsyncMock()
+    env.apply_network_policy = AsyncMock()
+    env.run_healthcheck = AsyncMock()
+    env.upload_file = AsyncMock()
+    env.upload_dir = AsyncMock()
+    created = []
+
+    def factory(**kwargs):
+        created.append(kwargs)
+        assert kwargs["config"].override_memory_mb is None
+        assert kwargs["config"].kwargs == {"namespace": "sandbox"}
+        assert kwargs["trial_paths"] != paths
+        assert kwargs["task_env_config"].memory_mb == 8192
+        return env
+
+    monkeypatch.setattr(
+        separate.EnvironmentFactory, "create_environment_from_config", factory
+    )
+    verifier = MagicMock()
+
+    async def verify():
+        new_paths = created[-1]["trial_paths"]
+        assert not new_paths.reward_text_path.exists()
+        new_paths.test_stdout_path.write_text("verifier output")
+        if failure == "verify":
+            raise RuntimeError("grading failed")
+        if failure == "timeout":
+            await asyncio.sleep(30)
+        if failure == "cancel":
+            raise asyncio.CancelledError()
+        new_paths.reward_json_path.write_text('{"reward": 0, "partial": 0.5}')
+        return VerifierResult(rewards={"reward": 0, "partial": 0.5})
+
+    verifier.verify = AsyncMock(side_effect=verify)
+    monkeypatch.setattr(separate, "Verifier", lambda **kwargs: verifier)
+    if failure == "start":
+        env.start.side_effect = RuntimeError("start failed")
+    args = (
+        task,
+        config,
+        paths,
+        [separate.SubmissionArtifact(patch, "/logs/artifacts/model.patch", False)],
+        0.01,
+        logging.getLogger(),
+    )
+    if failure:
+        error = (
+            asyncio.CancelledError
+            if failure == "cancel"
+            else asyncio.TimeoutError
+            if failure == "timeout"
+            else RuntimeError
+        )
+        with pytest.raises(error):
+            await separate.verify_separately(*args)
+    else:
+        result = await separate.verify_separately(*args)
+        assert result.rewards["reward"] == 0
+        first_session = created[-1]["session_id"]
+        await separate.verify_separately(*args)
+        assert created[-1]["session_id"] != first_session
+        assert paths.reward_json_path.exists()
+        env.upload_file.assert_awaited_with(
+            source_path=patch, target_path="/logs/artifacts/model.patch"
+        )
+        assert env.apply_network_policy.call_args.args[0].network_mode == "no-network"
+    assert not paths.reward_text_path.exists()
+    env.stop.assert_awaited_with(delete=True)
+    if failure != "start":
+        assert paths.test_stdout_path.read_text() == "verifier output"
+
+
