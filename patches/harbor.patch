+++ b/src/harbor/trial/separate_verifier.py
@@ -0,0 +1,241 @@
+"""Collect declared submissions and grade them in a fresh environment.
+
+Only declared artifacts cross from the agent into the verifier. Agent logs,
+runtime mounts and the agent's writable log directories are not shared.
+"""
+
+import asyncio
+import json
+import logging
+import shutil
+from dataclasses import dataclass
+from math import ceil
+from pathlib import Path, PurePosixPath
+from uuid import uuid4
+
+from harbor.environments.base import BaseEnvironment
+from harbor.environments.factory import EnvironmentFactory
+from harbor.models.environment_type import EnvironmentType
+from harbor.models.task.config import EnvironmentConfig
+from harbor.models.task.task import Task
+from harbor.models.trial.config import ArtifactConfig, TrialConfig
+from harbor.models.trial.paths import EnvironmentPaths, TrialPaths
+from harbor.models.verifier.result import VerifierResult
+from harbor.verifier.verifier import Verifier
+
+
+@dataclass(frozen=True)
+class SubmissionArtifact:
+    local: Path
+    remote: str
+    is_dir: bool
+
+
+def resolve_verifier_environment(task: Task) -> EnvironmentConfig:
+    """Inherit the task image/resources, then apply explicit verifier overrides."""
+    cfg = task.config.verifier
+    values = task.config.environment.model_dump()
+    if cfg.environment is not None:
+        overrides = cfg.environment.model_dump(exclude_unset=True)
+        # EnvironmentConfig's validator normalizes these even when omitted.
+        if overrides.get("network_mode") is None:
+            overrides.pop("network_mode", None)
+            overrides.pop("allowed_hosts", None)
+        overrides["env"] = {**values["env"], **overrides.get("env", {})}
+        values.update(overrides)
+    policy = cfg.explicit_phase_policy()
+    if policy is not None:
+        values.update(
+            network_mode=policy.network_mode, allowed_hosts=policy.allowed_hosts
+        )
+    return EnvironmentConfig.model_validate(values)
+
+
+async def collect_submission(
+    task: Task,
+    config: TrialConfig,
+    environment: BaseEnvironment,
+    paths: TrialPaths,
+) -> list[SubmissionArtifact]:
+    """Run collection once, before restoring history or modifying the worktree.
+
+    Hook/copy failures are infrastructure errors, not an empty submission or
+    a model failure. An intentionally empty patch is still a valid artifact.
+    """
+    for hook in task.config.verifier.collect:
+        result = await asyncio.wait_for(
+            environment.exec(
+                command=hook.command, user=hook.user, timeout_sec=ceil(hook.timeout_sec)
+            ),
+            timeout=hook.timeout_sec,
+        )
+        if result.return_code != 0:
+            raise RuntimeError(
+                f"verifier.collect failed ({result.return_code}): {result.stderr}"
+            )
+
+    artifacts = []
+    destinations: dict[Path, str] = {}
+    for entry in [*task.config.artifacts, *config.artifacts]:
+        entry = ArtifactConfig(source=entry) if isinstance(entry, str) else entry
+        source = PurePosixPath(entry.source)
+        destination = PurePosixPath(entry.destination or source.name)
+        if not source.is_absolute() or ".." in source.parts:
+            raise ValueError(f"Artifact source must be an absolute path: {source}")
+        if (
+            destination.is_absolute()
+            or ".." in destination.parts
+            or destination == PurePosixPath(".")
+        ):
+            raise ValueError(f"Artifact destination must be relative: {destination}")
+        target = paths.artifacts_dir / str(destination)
+        if target in destinations:
+            if destinations[target] == str(source):
+                continue
+            raise ValueError(f"Conflicting artifact destination: {destination}")
+        destinations[target] = str(source)
+        is_dir = await environment.is_dir(str(source), user="root")
+        # Mounted environments already expose convention artifacts on the host.
+        mounted_source = None
+        if environment.is_mounted and source.is_relative_to(
+            EnvironmentPaths.artifacts_dir
+        ):
+            mounted_source = paths.artifacts_dir / str(
+                source.relative_to(EnvironmentPaths.artifacts_dir)
+            )
+        if mounted_source != target:
+            if is_dir:
+                target.mkdir(parents=True, exist_ok=True)
+                await environment.download_dir(
+                    source_dir=str(source), target_dir=target
+                )
+            else:
+                target.parent.mkdir(parents=True, exist_ok=True)
+                await environment.download_file(
+                    source_path=str(source), target_path=target
+                )
+        if not target.exists():
+            raise FileNotFoundError(
+                f"Declared verifier artifact was not collected: {source}"
+            )
+        artifacts.append(SubmissionArtifact(target, str(source), is_dir))
+    paths.artifacts_dir.mkdir(parents=True, exist_ok=True)
+    paths.artifacts_manifest_path.write_text(
+        json.dumps(
+            [
+                {
+                    "source": artifact.remote,
+                    "destination": str(artifact.local.relative_to(paths.trial_dir)),
+                    "type": "directory" if artifact.is_dir else "file",
+                    "status": "ok",
+                }
+                for artifact in artifacts
+            ],
+            indent=2,
+        )
+    )
+    return artifacts
+
+
+async def verify_separately(
+    task: Task,
+    config: TrialConfig,
+    paths: TrialPaths,
+    artifacts: list[SubmissionArtifact],
+    timeout_sec: float,
+    logger: logging.Logger,
+) -> VerifierResult:
+    env_config = resolve_verifier_environment(task)
+    # Separate trial paths prevent an agent-written reward or mounted file from
+    # being mistaken for verifier output. Every retry gets a fresh environment.
+    suffix = uuid4().hex[:8]
+    verifier_paths = TrialPaths(paths.trial_dir / "verifier-environments" / suffix)
+    verifier_paths.mkdir()
+    backend = config.environment.model_copy(deep=True)
+    # Backend credentials and scheduling settings remain; agent runtime mounts
+    # and resource overrides must not replace the task's verifier definition.
+    backend.override_cpus = None
+    backend.override_memory_mb = None
+    backend.override_storage_mb = None
+    backend.override_gpus = None
+    backend.mounts_json = None
+    backend.env = {}
+    backend.kwargs = {
+        key: value
+        for key, value in backend.kwargs.items()
+        if not key.startswith("agent_runtime_") and key != "host_path_mounts"
+    }
+    extra = (
+        {"has_dynamic_network_policy": True}
+        if backend.type == EnvironmentType.DOCKER
+        else {}
+    )
+    environment = EnvironmentFactory.create_environment_from_config(
+        config=backend,
+        environment_dir=task.paths.environment_dir,
+        environment_name=task.name,
+        session_id=f"{config.trial_name}-verifier-{suffix}",
+        trial_paths=verifier_paths,
+        task_env_config=env_config,
+        logger=logger,
+        **extra,
+    )
+    try:
+        multiplier = config.environment_build_timeout_multiplier
+        if multiplier is None:
+            multiplier = config.timeout_multiplier
+        await asyncio.wait_for(
+            environment.start(force_build=False),
+            env_config.build_timeout_sec * multiplier,
+        )
+        await environment.apply_network_policy(env_config.resolve_baseline())
+        await environment.run_healthcheck()
+        environment.default_user = task.config.verifier.user
+        for artifact in artifacts:
+            if artifact.is_dir:
+                await environment.upload_dir(
+                    source_dir=artifact.local, target_dir=artifact.remote
+                )
+            else:
+                await environment.upload_file(
+                    source_path=artifact.local, target_path=artifact.remote
+                )
+        verifier = Verifier(
+            task=task,
+            trial_paths=verifier_paths,
+            environment=environment,
+            override_env=config.verifier.env or None,
+            allowed_rewards=config.verifier.allowed_rewards,
+        )
+        return await asyncio.wait_for(verifier.verify(), timeout_sec)
+    finally:
+        # Preserve diagnostic output on timeout/error without masking that error.
+        try:
+            if not environment.is_mounted:
+                try:
+                    await asyncio.wait_for(
+                        environment.download_dir(
+                            source_dir=str(EnvironmentPaths.verifier_dir),
+                            target_dir=verifier_paths.verifier_dir,
+                        ),
+                        timeout=60,
+                    )
+                except Exception:
+                    logger.warning(
+                        "Could not download separate verifier logs", exc_info=True
+                    )
+            paths.verifier_dir.mkdir(parents=True, exist_ok=True)
+            for reward in (paths.reward_text_path, paths.reward_json_path):
+                reward.unlink(missing_ok=True)
+            shutil.copytree(
+                verifier_paths.verifier_dir, paths.verifier_dir, dirs_exist_ok=True
+            )
+        except Exception:
+            logger.warning("Could not recover separate verifier logs", exc_info=True)
+        finally:
+            try:
+                await asyncio.shield(environment.stop(delete=config.environment.delete))
+            except Exception:
+                logger.warning(
+                    "Could not stop separate verifier environment", exc_info=True
+                )
