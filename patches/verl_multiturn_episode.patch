+def compute_trial_length_adaptive_lam(trial_gen_tokens: torch.Tensor, alpha: float) -> torch.Tensor:
+    """Length-adaptive lambda over a WHOLE compacted trial: ``1 - 1/(alpha * L_trial)``.
+
+    CompactionRL (https://arxiv.org/abs/2607.05378) splits a trial into token segments
+    that are trained as separate rows. With ``L_trial`` counting the policy tokens of
+    every segment of the trial, the cross-segment discount of an earlier segment
+    becomes ``lam ** N_{>s} = exp(-N_{>s} / (alpha * L_trial))``, which lies in
+    ``[exp(-1/alpha), 1]``: bounded, and tied to how much of the trial's work still
+    lies ahead. A per-segment lambda raised to tens of thousands of later tokens
+    would vanish instead.
+
+    Args:
+        trial_gen_tokens: `(torch.Tensor)` shape (bs,), policy tokens of the whole
+            trial each row belongs to.
+        alpha: length-scaling factor, as in :func:`compute_length_adaptive_lam`.
+
+    Returns:
+        `(torch.Tensor)` shape (bs,), a per-row lambda.
+    """
+    if alpha <= 0:
+        raise ValueError(f"length_adaptive_lam_alpha must be positive, got {alpha}.")
+    lengths = trial_gen_tokens.to(torch.float32).clamp(min=1.0)
+    return 1.0 - 1.0 / (alpha * lengths)
+
+def compute_cross_segment_scale(gamma, lam, tokens_after: torch.Tensor) -> torch.Tensor:
+    """CompactionRL's trajectory-position correction (eq. 14 of arXiv:2607.05378).
+
+    A trial compacted into several segments shares one terminal reward, but a naive
+    per-segment GAE puts that reward at the end of every segment, so early segments
+    see the outcome as closer than it is. Scaling a row's advantages by
+    ``(gamma * lam) ** N_{>s}``, with ``N_{>s}`` the policy tokens generated after
+    the row's segment in the same trial, restores the distance of the concatenated
+    rollout. ``N_{>s} = 0`` (the last segment, and every uncompacted trajectory)
+    gives scale 1, so the correction is a no-op without compaction.
+
+    Args:
+        gamma: `(float)` or 0-d tensor.
+        lam: `(float)` or `(torch.Tensor)` of shape (bs,) (per-row lambda).
+        tokens_after: `(torch.Tensor)` shape (bs,).
+
+    Returns:
+        `(torch.Tensor)` shape (bs,), float32.
+    """
+    exponent = tokens_after.to(torch.float64).clamp(min=0.0)
+    lam_t = torch.as_tensor(lam, dtype=torch.float64, device=exponent.device)
+    gamma_t = torch.as_tensor(gamma, dtype=torch.float64, device=exponent.device)
+    base = (gamma_t * lam_t).clamp(min=0.0)
+    if base.dim() == 0:
+        base = base.expand_as(exponent)
+    return torch.pow(base, exponent).to(torch.float32)
+
