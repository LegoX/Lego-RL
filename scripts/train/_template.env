# scripts/train/_template.env
# Copy this file to scripts/train/configs/<experiment>.env, then replace every
# CHANGEME value before generating a runnable script.

# --- template selection -----------------------------------------------
# Select one template from each configurable dimension.
# Available values come from scripts/templates/<dimension>/*.env.
BACKEND=CHANGEME        # k8s | docker
SCAFFOLD=CHANGEME       # ohsdk | oh | cc | oc
TRAINING_MODE=CHANGEME  # async | sync
MODEL_ENGINE=CHANGEME   # veomni | fsdp

# --- identity ----------------------------------------------------------
# Required by trainer.project_name / trainer.experiment_name and log paths.
PROJECT_NAME=CHANGEME
EXP_NAME=CHANGEME

# --- runtime -----------------------------------------------------------
# Required by runtime/process.env and the generated runnable script.
VENV_PATH=CHANGEME
WANDB_API_KEY=

# --- model -------------------------------------------------------------
# Required by actor_rollout_ref.model.* and vLLM tool-call parsing.
MODEL_PATH=CHANGEME
TOOL_CALL_PARSER=CHANGEME

# --- data --------------------------------------------------------------
# Required by data.train_files / data.val_files.
TRAIN_FILES=CHANGEME
VAL_FILES=CHANGEME

# --- cluster topology --------------------------------------------------
# Required by Ray bring-up and verl rollout/trainer topology.
NNODES=CHANGEME
N_NODES_TRAIN=CHANGEME
N_NODES_ROLLOUT=CHANGEME

# Required when BACKEND=k8s.
K8S_KUBECONFIG=CHANGEME

# --- cadence -----------------------------------------------------------
# Required by trainer.total_epochs in the current verl/common.env template.
TOTAL_EPOCHS=CHANGEME

# --- optional experiment overrides ------------------------------------
# Uncomment or override these only when the run needs values different from the
# selected templates.
# MAX_PROMPT=30000
# MAX_RESP=91072
# SP_SIZE=4
# TRAIN_BSZ=64
# TRAIN_MINI_BSZ=64
# N_RESP=8
# USE_DYNAMIC_BSZ=False
# TRAINER_SAVE_FREQ=10
# TRAINER_TEST_FREQ=5
# TRAINER_VAL_BEFORE_TRAIN=True
# ENABLE_R3=True     # MoE only. Leave unset: the default is read off MODEL_PATH's
#                    # config.json. Setting True on a dense model is blocked by preflight.

# --- optional site/backend values -------------------------------------
# These may be required on clusters without public registry or dataset image
# access. Leave them explicit in the final config when the site needs them.
# HARBOR_OPENSWE_IMAGE_REGISTRY=CHANGEME
# HARBOR_NYDUS_MIRROR=CHANGEME
# HARBOR_HOSTPATH_MOUNTS=CHANGEME

# --- template composition ---------------------------------------------
# Keep this after explicit settings because module paths depend on selections
# above, and sourced templates may depend on those settings.
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
