# scripts/train/examples/demo.env
#
# A small but real training run — the shortest config that actually trains a
# policy on repository tasks. Used by the Demo Run page:
#
#   cp scripts/train/examples/demo.env scripts/train/configs/demo.env
#   $EDITOR scripts/train/configs/demo.env      # replace the three CHANGEME values
#   /rl:run scripts/train/configs/demo.env      # or: bash scripts/train/train.sh <config>
#
# Unlike examples/quickstart.env this one is meant to be launched. It needs an
# 8-GPU host, a checkpoint, two task indexes and a reachable sandbox backend.
# To check the structure before those exist:
#
#   PREFLIGHT_ONLY=1 bash scripts/train/train.sh scripts/train/examples/demo.env

# --- template selection -----------------------------------------------
# k8s schedules each trial as a pod. It only ever pulls images, never builds
# them, so the task images must already be in a registry the cluster can reach.
# BACKEND=docker drives one machine's daemon instead and can build on demand.
BACKEND=k8s             # k8s | docker
SCAFFOLD=ohsdk          # ohsdk | oh | cc | oc
TRAINING_MODE=sync      # sync | async
MODEL_ENGINE=veomni     # veomni | fsdp

# --- identity ----------------------------------------------------------
PROJECT_NAME=lego-rl-demo
EXP_NAME=demo

# --- runtime -----------------------------------------------------------
VENV_PATH=${REPO_ROOT}/.venv

# ======================================================================
# The three values below are the only ones you must supply. Everything
# else in this file is a working default.
# ======================================================================

# --- model -------------------------------------------------------------
# Your policy checkpoint, typically SFT-trained. TOOL_CALL_PARSER must match the
# checkpoint's chat template: qwen3.5/3.6 are XML, so qwen3_coder is the pairing.
MODEL_PATH=CHANGEME
TOOL_CALL_PARSER=qwen3_coder

# --- data --------------------------------------------------------------
# Task indexes: parquet pointer tables the trainer samples from.
TRAIN_FILES=CHANGEME
VAL_FILES=CHANGEME

# --- cluster -----------------------------------------------------------
# The runners do not read scripts/lib/site.env, so the cluster path lives here.
K8S_KUBECONFIG=CHANGEME

# ======================================================================

# --- cluster topology --------------------------------------------------
# One 8-GPU host, rollout colocated with training (TRAINING_MODE=sync).
NNODES=1
N_NODES_TRAIN=1
N_NODES_ROLLOUT=0
SP_SIZE=8

# --- demo scale --------------------------------------------------------
# 8 x 4 = 32 trials/step instead of the default 64 x 8 = 512: roughly 8x faster
# per step, and it still exercises the whole path (sandboxes, agent, verifier,
# gradient). The gradients are noisy and the reward groups degenerate at this
# size, so read this run as a plumbing check, never as a learning signal.
TRAIN_BSZ=8
TRAIN_MINI_BSZ=8
N_RESP=4

# --- cadence -----------------------------------------------------------
# Small so the first checkpoint and the first val land within the demo rather
# than ten steps in.
TOTAL_EPOCHS=1
TRAINER_SAVE_FREQ=5
TRAINER_TEST_FREQ=5
TRAINER_VAL_BEFORE_TRAIN=False

# --- image source ------------------------------------------------------
# k8s never builds, it only pulls, so a run needs exactly one image source.
# Inline build needs no registry and is the portable choice for a demo: each pod
# builds its task image from the Dockerfile on first use. It is slow, and it does
# not scale past a demo — for a real run leave this false and set
# HARBOR_OPENSWE_IMAGE_REGISTRY to a registry holding prebuilt task images.
# Setting both, or neither, is a preflight FATAL.
HARBOR_K8S_INLINE_BUILD=true
HARBOR_OPENSWE_IMAGE_REGISTRY=

# --- values preflight checks -------------------------------------------
# A window this size fits one training node at 35B; the full 200k window needs two.
MAX_PROMPT=30000
MAX_RESP=58304
# total_training_steps=-1 turns a decaying schedule into lr=0; constant avoids it.
LR_SCHEDULER=constant
# Without a val-specific timeout, long val tasks are cut off by the train timeout.
HARBOR_VAL_AGENT_MAX_TIMEOUT_SEC=4800

# --- template composition ---------------------------------------------
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
