# Copy and edit the model, dataset, environment and sandbox paths before use.
BACKEND=k8s
SCAFFOLD=cc
TRAINING_MODE=async
MODEL_ENGINE=veomni
PROJECT_NAME=lego-rl-multiturn
EXP_NAME=multiturn-sao
VENV_PATH=/path/to/Lego-RL/.venv
MODEL_PATH=/path/to/Qwen3.5-35B-A3B
CRITIC_MODEL_PATH=/path/to/critic
TOOL_CALL_PARSER=qwen3_coder
TRAIN_FILES=/path/to/train.parquet
VAL_FILES=/path/to/val.parquet
K8S_KUBECONFIG=/path/to/kubeconfig.yaml
NNODES=8
N_NODES_TRAIN=4
N_NODES_ROLLOUT=4
TOTAL_EPOCHS=1
TRAIN_BSZ=64
TRAIN_MINI_BSZ=64
MAX_PROMPT=48000
MAX_RESP=152000
ROLLOUT_MAX_MODEL_LEN=200000
GEN_TP=4
HARBOR_MULTITURN_TASK_PROFILE=swe_interact
HARBOR_SWE_INTERACTION_MODE=conversation
HARBOR_SWE_INTERACT_MANIFEST=/path/to/frozen-task-manifest.jsonl
HARBOR_SWE_NATIVE_ROOT=/path/to/native-benchmark
HARBOR_SWE_RUNTIME_IMAGE=registry.example/claude-code-runtime@sha256:REPLACE_WITH_DIGEST
HARBOR_MULTITURN_SIMULATOR_MODEL=openai/your-fixed-user-model
HARBOR_MULTITURN_SIMULATOR_API_BASE=https://your-user-service.example/v1
HARBOR_MULTITURN_SIMULATOR_API_KEY_ENV=MULTITURN_SIMULATOR_API_KEY
HARBOR_MULTITURN_MAX_ROUNDS=5
HARBOR_MULTITURN_SIMULATOR_TIMEOUT_SEC=1200
HARBOR_MULTITURN_EPISODE_TIMEOUT_SEC=7200
HARBOR_SWE_TRIAL_MAX_RETRIES=3
HARBOR_TRIAL_GEN_TOKEN_BUDGET=200000
TRAINER_RESUME_MODE=disable
TRAINER_VAL_BEFORE_TRAIN=False
CRITIC_WARMUP=6

TEMPLATE_MODULES=(
  harbor/multiturn.env
  verl/sao.env
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
