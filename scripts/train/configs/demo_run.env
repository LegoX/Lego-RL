# scripts/train/configs/fully_async_3nodes_qwen35_ohsdk_veomni.env

# This file is intentionally explicit: do not use environment fallbacks here.

# --- template selection -----------------------------------------------
BACKEND=k8s
SCAFFOLD=ohsdk
TRAINING_MODE=async
MODEL_ENGINE=veomni

# --- identity ----------------------------------------------------------
PROJECT_NAME=h20_demo_debug
EXP_NAME=ohsdk-$(date +%Y%m%d-%H%M%S)

# --- runtime -----------------------------------------------------------
VENV_PATH=/mnt/data/yuantao/code/Lego-RL/.venv
# K8s sandboxes and training nodes share this network. Ray node addresses and
# NCCL/GLOO/TP socket bootstrap all derive from the same interface.
TRAIN_NETWORK_INTERFACE=net0
HARBOR_LOG_DIR=/mnt/data/yuantao/code/Lego-RL/harbor_trials/${PROJECT_NAME}/${EXP_NAME}/logs
HARBOR_TRIALS_DIR=/mnt/data/yuantao/code/Lego-RL/harbor_trials/${PROJECT_NAME}/${EXP_NAME}
# Inherited from the launching shell — never commit a key to the repo.
# export WANDB_API_KEY=... before running, or put it in an untracked local env file.
WANDB_API_KEY=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

# --- model -------------------------------------------------------------
MODEL_PATH=/mnt/data/yuantao/models/Qwen3.5-35B-A3B
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder

# --- data --------------------------------------------------------------
TRAIN_FILES=/mnt/data/yuantao/data/openswe_2699.parquet
VAL_FILES=/mnt/data/yuantao/data/val_swebench_verified_500.parquet

# --- cluster topology --------------------------------------------------
NNODES=2
N_NODES_TRAIN=1
N_NODES_ROLLOUT=1
# ROLLOUT_N_GPUS_PER_NODE=4
# TRAINER_N_GPUS_PER_NODE=4
K8S_KUBECONFIG=/mnt/data/yuantao/code/cpu-10.11.1.201.yaml

# --- cadence -----------------------------------------------------------
TOTAL_EPOCHS=3

# --- overrides -----------------------------------------
HARBOR_LOGGING_LEVEL=INFO
HARBOR_OPENSWE_IMAGE_REGISTRY=10.11.1.201:5000
HARBOR_NYDUS_MIRROR=10.11.1.201:5000
# HARBOR_HOSTPATH_MOUNTS='[{"host_path":"/path/to/node-local/swe-rebench-v2-c71902a","mount_path":"/opt/rebench-v2","read_only":true},{"host_path":"/path/to/node-local/grading-toolchain","mount_path":"/opt/grading","read_only":true}]'
HARBOR_POD_NAME_PREFIX=ohsdk-q35b
HARBOR_AGENT_MAX_TIMEOUT_SEC=3600
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=3600
HARBOR_NETADMIN_IMAGE="10.11.1.201:5000/harbor-netadmin:iptables"
# HARBOR_AGENT_RUNTIME_IMAGE=10.11.1.201:5000/jierun/c-oh-sdk-1.33.0:v0.1
TRAINER_VAL_BEFORE_TRAIN=False
# HARBOR_K8S_EGRESS_ISOLATION=0
# HARBOR_K8S_INLINE_BUILD=True

MAX_PROMPT=30000
MAX_RESP=90000
SP_SIZE=8
EP_SIZE=1
ENABLE_R3=True
AGENT_NUM_WORKERS=16
TRAIN_BSZ=8
TRAIN_MINI_BSZ=8
TRAINER_LOGGER=['console','wandb']

# --- template composition ---------------------------------------------
# Keep this after explicit settings because module paths depend on selections
# above, and sourced templates may depend on those settings.
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
