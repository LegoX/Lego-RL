# Metadata-controlled mixed OpenHands SDK / OpenCode / Claude Code.

# --- template selection -----------------------------------------------
BACKEND=k8s
SCAFFOLD=mixed
TRAINING_MODE=async
MODEL_ENGINE=veomni

# --- identity ----------------------------------------------------------
PROJECT_NAME=harbor-swe-mixed-qwen3.5-35b-3nodes-veomni
EXP_NAME=mixed-$(date +%Y%m%d-%H%M%S)

# --- runtime -----------------------------------------------------------
VENV_PATH=${REPO_ROOT}/.venv
HARBOR_LOG_DIR=/path/to/shared/harbor_trials/${PROJECT_NAME}/${EXP_NAME}/logs
HARBOR_TRIALS_DIR=/path/to/shared/harbor_trials/${PROJECT_NAME}/${EXP_NAME}
WANDB_API_KEY="${WANDB_API_KEY:-}"

# --- model -------------------------------------------------------------
MODEL_PATH=/path/to/models/Qwen3.5-35B-A3B
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder

# --- data --------------------------------------------------------------
# Set extra_info.agent_harness to one of openhands_sdk, opencode, or claude_code
# for explicit selection. Rows without it use the policy below.
TRAIN_FILES=/path/to/data/train_with_optional_agent_harness.parquet
VAL_FILES=/path/to/data/val_with_optional_agent_harness.parquet

# --- cluster topology --------------------------------------------------
NNODES=3
N_NODES_TRAIN=2
N_NODES_ROLLOUT=1
K8S_KUBECONFIG=/path/to/kubeconfig

# --- cadence -----------------------------------------------------------
TOTAL_EPOCHS=3

# --- mixed harness policy ---------------------------------------------
HARBOR_HARNESS_DEFAULT=openhands_sdk
HARBOR_HARNESS_FALLBACK=weighted_random
HARBOR_HARNESS_RANDOM_SEED=1234
HARBOR_HARNESS_GRANULARITY=task
HARBOR_HARNESS_WEIGHT_OHSDK=1.0
HARBOR_HARNESS_WEIGHT_OC=1.0
HARBOR_HARNESS_WEIGHT_CC=1.0

# --- shared overrides --------------------------------------------------
MAX_PROMPT=30000
MAX_RESP=170000
SP_SIZE=8
EP_SIZE=1
ENABLE_R3=True

# --- template composition ---------------------------------------------
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
