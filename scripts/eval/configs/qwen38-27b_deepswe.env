# Qwen3.8-27B / DeepSWE v1.1, Harbor + Claude Code on Kubernetes.
# Model card: https://huggingface.co/Qwen/Qwen3.8-27B (DeepSWE 1.1: 42.2).
# Disclosed recipe: Claude Code, temperature=1.0, top_p=0.95, 256K context.
# CC version, DeepSWE output budget, turn limit and trial averaging were not
# disclosed. The pins/budgets below are local choices, not an exact reproduction.
# Dataset revision: 0b9fabbb63b9104d678fe965e1632f2dd9eaa2ea (v1.1).
# Set site paths and a worker-accessible netadmin image before launching.
# Setup and smoke-test instructions: utils/README.md -> DeepSWE.
BACKEND=k8s
SCAFFOLD=cc
EVAL_AGENT_NAME=claude-code

PROJECT_NAME=eval-qwen38-27b-deepswe-cc
EXP_NAME=eval-qwen38-27b-deepswe-cc-$(date +%Y%m%d-%H%M%S)
POD_PREFIX=q38dscc
STEP_TAG=deepswe
VENV_PATH=${REPO_ROOT}/.venv
EVAL_EXTRA_PYTHONPATH=

MODEL_PATH=${MODEL_PATH:-/path/to/Qwen3.8-27B}
SERVED_MODEL_NAME=Qwen3.8-27B
DATASET_PATH=${DATASET_PATH:-/path/to/deep-swe}
TOOL_CALL_PARSER=qwen3_coder
EVAL_REQUIRE_SEPARATE_VERIFIER=true
EVAL_REWARD_KEY=reward
EVAL_REWARD_VALUES='[0,1]'

EVAL_TEMPERATURE=1.0
# Reserve 32K generation within the 256K total window.
MAX_INPUT_TOKENS=229376
MAX_OUTPUT_TOKENS=32768
MAX_MODEL_LEN=262144
# CC does not consume Harbor's model_info for its compaction/output budgets.
EVAL_AGENT_EXTRA_ENV='{"CLAUDE_CODE_MAX_CONTEXT_TOKENS":"262144","CLAUDE_CODE_MAX_OUTPUT_TOKENS":"32768","HARBOR_EVAL_CC_SUBMISSION_GUARD":"1"}'
HARBOR_AGENT_VERSION=2.1.118
HARBOR_AGENT_RUNTIME_IMAGE=docker.io/jierun/c-cc-2.1.118:v0.1
HARBOR_TRIAL_OVERLONG_TOTAL_TOKENS=0

GEN_TP=8
GPU_MEM_UTIL=0.85
VLLM_PORT=8000
EVAL_ENABLE_EXPERT_PARALLEL=false
# Dense BF16 model. Native /v1/messages serves CC without a protocol proxy.
# Keep vLLM compilation and CUDA Graphs enabled for decode performance.
# CC's x-harbor-temperature header is not a vLLM sampling override: set the
# server defaults explicitly. top_k=20 follows the model's generation_config.
# Keep JSON arguments compact: the runner splits this string on whitespace.
# Qwen's default thinking/preserved history use xhigh, not Claude's "high" enum.
EVAL_VLLM_EXTRA_ARGS='--enable-chunked-prefill --enable-prefix-caching --dtype bfloat16 --reasoning-parser qwen3 --generation-config auto --override-generation-config {"temperature":1.0,"top_p":0.95,"top_k":20,"min_p":0.0,"presence_penalty":0.0,"repetition_penalty":1.0} --default-chat-template-kwargs {"enable_thinking":true,"preserve_thinking":true,"reasoning_effort":"xhigh"}'
EVAL_VLLM_READY_ITERS=360

N_CONCURRENT=8
MAX_RETRIES=2
# No arbitrary 200-turn cutoff; use the task's own agent timeout (3h).
# The eval runner uses one attempt per task, not avg@3 / pass@k.
HARBOR_AGENT_MAX_ITERATIONS=null
# null preserves each task's own time/resource budget.
HARBOR_AGENT_MAX_TIMEOUT_SEC=null
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=null
HARBOR_AGENT_TIMEOUT_MULTIPLIER=1.0
HARBOR_VERIFIER_TIMEOUT_MULTIPLIER=1.0
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=null
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=null
HARBOR_ENVIRONMENT_MEMORY_LIMIT_FACTOR=1.5
# All v1.1 tasks declare 2 CPUs. A quota lets joblib detect that budget instead
# of spawning workers for every CPU on the Kubernetes node (and running OOM).
HARBOR_ENVIRONMENT_OVERRIDE_CPU_LIMIT=2
LLM_TIMEOUT=1200

# Official images already contain the repository and dependencies. Their Git
# history is pruned upstream; preserve base_commit -> agent HEAD for collect.
HARBOR_K8S_SKIP_DOCKERFILE=true
HARBOR_BLOCK_GIT_HISTORY_LEAK=0
HARBOR_K8S_STRICT_NETWORK_POLICY=true
# Permit only the explicitly configured model API host, not the whole LAN.
HARBOR_K8S_ALLOW_PRIVATE_NETWORK=false
# MongoDB-backed tests exceed containerd's default 1024 open-file soft limit.
HARBOR_K8S_NOFILE=65536
HARBOR_HOSTPATH_MOUNTS=null
HARBOR_NYDUS_MIRROR=
K8S_KUBECONFIG=${K8S_KUBECONFIG:-/path/to/kubeconfig}
K8S_POD_ACTIVE_DEADLINE_SECONDS=14400
# Set this to an image with iptables that your Kubernetes workers can pull.
HARBOR_NETADMIN_IMAGE=${HARBOR_NETADMIN_IMAGE:-your-registry/harbor-netadmin:iptables}

TEMPLATE_MODULES=(
  runtime/process.env
  eval/common.env
  eval/vllm.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
