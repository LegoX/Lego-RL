# scripts/eval/configs/qwen35_30b_a3b_official_verified.env

# --- template selection -----------------------------------------------
BACKEND=k8s
SCAFFOLD=ohsdk

# --- identity ----------------------------------------------------------
PROJECT_NAME=eval-qwen35-30b-a3b-verified
EXP_NAME=eval-ohsdk-qwen35-30b-a3b-verified-$(date +%Y%m%d-%H%M%S)
POD_PREFIX=q35v
STEP_TAG=verified

# --- runtime -----------------------------------------------------------
VENV_PATH=/path/to/repo/.venv

# --- model -------------------------------------------------------------
MODEL_PATH=/path/to/models/Qwen3.5-35B-A3B
TOOL_CALL_PARSER=qwen3_coder

# --- dataset -----------------------------------------------------------
# Set exactly one of DATASET_PATH or DATASET_NAME.
DATASET_PATH=/path/to/swebench-verified
# DATASET_NAME=swebench-verified

# Required when BACKEND=k8s.
K8S_KUBECONFIG=/path/to/kubeconfig.yaml

# --- optional eval overrides ------------------------------------------
N_CONCURRENT=96
MAX_RETRIES=2
EVAL_TEMPERATURE=0.7
MAX_INPUT_TOKENS=200000
MAX_OUTPUT_TOKENS=32768
MAX_MODEL_LEN=262144
GEN_TP=8
GPU_MEM_UTIL=0.9
VLLM_PORT=8000
EVAL_ENABLE_EXPERT_PARALLEL=true
EVAL_VLLM_EXTRA_ARGS="--enable-chunked-prefill --enable-prefix-caching --dtype bfloat16"
EVAL_VLLM_READY_ITERS=360
HARBOR_AGENT_MAX_TIMEOUT_SEC=7200
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=7200
K8S_POD_ACTIVE_DEADLINE_SECONDS=8400
HARBOR_OPENSWE_IMAGE_REGISTRY=ip:port # optional
HARBOR_NYDUS_MIRROR=ip:port # optional
HARBOR_NETADMIN_IMAGE=netadmin-image:tag # optional
# HARBOR_HOSTPATH_MOUNTS='[{"host_path":"/path/to/node-local/swe-rebench-v2-c71902a","mount_path":"/opt/rebench-v2","read_only":true}]'

# --- template composition ---------------------------------------------
# Keep this after explicit settings because module paths and derived defaults
# depend on values above.
TEMPLATE_MODULES=(
  runtime/process.env
  eval/common.env
  eval/vllm.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
