# scripts/eval/configs/qwen35-35b_official_multilingual.env
# SWE-bench Multilingual (300 tasks, 9 languages) with the OpenHands SDK scaffold on k8s.
# Dataset: utils/convert_swebench_multilingual.py. The offline grader mount and the image
# mirror below are prerequisites, not optimisations -- without them every task scores 0.
# Full setup (order matters): utils/README.md -> "Setting up an official SWE-bench benchmark"

# --- template selection -----------------------------------------------
BACKEND=k8s
SCAFFOLD=ohsdk

# --- identity ----------------------------------------------------------
PROJECT_NAME=eval-qwen35-35b-multilingual
EXP_NAME=eval-qwen35-35b-multilingual-$(date +%Y%m%d-%H%M%S)
POD_PREFIX=q35m
STEP_TAG=multilingual

# --- runtime -----------------------------------------------------------
VENV_PATH=/path/to/repo/.venv
EVAL_EXTRA_PYTHONPATH=

# --- model/dataset -----------------------------------------------------
MODEL_PATH=/path/to/models/Qwen3.5-35B-A3B
# As seen from the EVAL host. The task paths inside the index/dataset must also resolve
# from there; hostPath mounts below are resolved NODE-side instead.
DATASET_PATH=/path/to/shared/harbor_swebench_multilingual_300
TOOL_CALL_PARSER=qwen3_coder
HARBOR_AGENT_PARSER_NAME=qwen3_coder

# --- sampling/context --------------------------------------------------
EVAL_TEMPERATURE=1.0
MAX_INPUT_TOKENS=200000
MAX_OUTPUT_TOKENS=32768
MAX_MODEL_LEN=262144

# --- vLLM serving ------------------------------------------------------
GEN_TP=8
GPU_MEM_UTIL=0.85
VLLM_PORT=8000
EVAL_ENABLE_EXPERT_PARALLEL=true
EVAL_VLLM_EXTRA_ARGS="--enforce-eager --enable-chunked-prefill --enable-prefix-caching --dtype bfloat16"
EVAL_VLLM_READY_ITERS=360

# --- harbor/backend overrides -----------------------------------------
N_CONCURRENT=16
MAX_RETRIES=2
HARBOR_AGENT_MAX_ITERATIONS=200
HARBOR_AGENT_MAX_TIMEOUT_SEC=4800
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=4800
# READ THIS BEFORE CHANGING THE TIMEOUTS. What a harbor job actually enforces is
#     min(override_timeout_sec, max_timeout_sec) * multiplier
# with override/max coming from the task's own task.toml when the config does not set them
# (3000 s for this dataset). HARBOR_AGENT_MAX_TIMEOUT_SEC alone does NOT reach the job, so
# a config asking for 7200 still died at 3000. 1.6 x 3000 = 4800 s is measured, not guessed:
# agent wall-clock over the 300 tasks is median ~1200 s, p90 ~3200 s, p99 4800 s, and
# nothing solved past ~40 min — a 3600 s cap cuts 21 trials, 7 of them solved, i.e. ~2 points
# of score lost to a timeout rather than to the model. Going above 4800 buys ~nothing.
HARBOR_AGENT_TIMEOUT_MULTIPLIER=1.6
# Verifiers are cheap here (median ~24 s, p99 ~143 s against a 3000 s declaration); 1.0 is
# plenty. Raise it only for benchmarks with service-level verifiers.
HARBOR_VERIFIER_TIMEOUT_MULTIPLIER=1.0
HARBOR_AGENT_RUNTIME_IMAGE=docker.io/jierun/c-oh-sdk-1.33.0:v0.1
# 2 CPU / 8 GiB per pod: these verifiers run cargo / maven / go test, which starve at one core.
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=2
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192
# LOAD-BEARING. host_path is resolved NODE-side (it is a hostPath), so this directory must
# exist on every sandbox node — shared storage, or replicated. Without it every trial is a
# false reward 0 (see the header).
HARBOR_HOSTPATH_MOUNTS='[{"host_path":"/path/to/data/grading-toolchain-v2","mount_path":"/opt/grading","read_only":true}]'
# Local mirror of docker.io/swebench/sweb.eval.x86_64.*; empty = pull from Docker Hub.
HARBOR_NYDUS_MIRROR=
# Nodes with no route to the vLLM host, if any: pods there fail every LLM call and burn a trial.
HARBOR_EXCLUDE_NODES=
K8S_KUBECONFIG=$HOME/.kube/config
K8S_POD_ACTIVE_DEADLINE_SECONDS=8400

# --- template composition ---------------------------------------------
TEMPLATE_MODULES=(
  runtime/process.env
  eval/common.env
  eval/vllm.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
