# scripts/eval/configs/qwen35-35b_official_pro.env
# SWE-bench Pro (731 public tasks: python / go / js / ts) with the OpenHands SDK scaffold on k8s.
# Dataset: utils/convert_swebench_pro.py (official jefzda/sweap-images:*, repo at /app,
# per-instance run_script.sh + parser.py). 15 instances have an upstream gold patch that fails
# its own tests: <output-dir>_known_invalid_gold_ids.txt.
# Full setup, including the python and go subsets that need more than a converter:
# utils/README.md -> "Setting up an official SWE-bench benchmark"

# --- template selection -----------------------------------------------
BACKEND=k8s
SCAFFOLD=ohsdk

# --- identity ----------------------------------------------------------
PROJECT_NAME=eval-qwen35-35b-pro
EXP_NAME=eval-qwen35-35b-pro-$(date +%Y%m%d-%H%M%S)
POD_PREFIX=q35p
STEP_TAG=pro

# --- runtime -----------------------------------------------------------
VENV_PATH=/path/to/repo/.venv
EVAL_EXTRA_PYTHONPATH=

# --- model/dataset -----------------------------------------------------
MODEL_PATH=/path/to/models/Qwen3.5-35B-A3B
DATASET_PATH=/path/to/shared/harbor_swebench_pro_731
TOOL_CALL_PARSER=qwen3_coder
HARBOR_AGENT_PARSER_NAME=qwen3_coder

# --- sampling/context --------------------------------------------------
EVAL_TEMPERATURE=1.0
MAX_INPUT_TOKENS=200000
MAX_OUTPUT_TOKENS=32768
MAX_MODEL_LEN=262144

# --- vLLM serving ------------------------------------------------------
GEN_TP=8
GPU_MEM_UTIL=0.85
VLLM_PORT=8000
EVAL_ENABLE_EXPERT_PARALLEL=true
EVAL_VLLM_EXTRA_ARGS="--enforce-eager --enable-chunked-prefill --enable-prefix-caching --dtype bfloat16"
EVAL_VLLM_READY_ITERS=360

# --- harbor/backend overrides -----------------------------------------
N_CONCURRENT=16
MAX_RETRIES=2
HARBOR_AGENT_MAX_ITERATIONS=200
HARBOR_AGENT_MAX_TIMEOUT_SEC=4800
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=4800
# min(override, max) * multiplier is what a harbor job enforces, and override/max default to
# the task's own task.toml (3000 s here). HARBOR_AGENT_MAX_TIMEOUT_SEC alone does NOT reach the
# job, so the multiplier is the knob: 1.6 -> 4800 s agent, 2.0 -> 6000 s verifier.
HARBOR_AGENT_TIMEOUT_MULTIPLIER=1.6
HARBOR_VERIFIER_TIMEOUT_MULTIPLIER=2.0
HARBOR_AGENT_RUNTIME_IMAGE=docker.io/jierun/c-oh-sdk-1.33.0:v0.1
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=2
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192
# /opt/grading is only the fallback interpreter for the official parser.py here (Pro grades with
# its own per-instance parser, not swebench's log parsers), but the images without python3 still
# need it. Add the goproxy mount for the go subset:
#   ,{"host_path":"/path/to/data/goproxy-pro","mount_path":"/opt/goproxy","read_only":true}
HARBOR_HOSTPATH_MOUNTS='[{"host_path":"/path/to/data/grading-toolchain-v2","mount_path":"/opt/grading","read_only":true}]'
# Local mirror of docker.io/jefzda/sweap-images:*; empty = pull from Docker Hub.
HARBOR_NYDUS_MIRROR=
HARBOR_EXCLUDE_NODES=
K8S_KUBECONFIG=$HOME/.kube/config
K8S_POD_ACTIVE_DEADLINE_SECONDS=8400

# The 266 python-repo tasks need the TASK image's python in the agent's tool shell, not the
# oh-sdk runtime's embedded one (114/266 -> 135/266 solved). Both knobs are inert unless
# OH_SDK_PATCH_ROOT points at a patched runtime entrypoint -- see the docs page.
#OH_SDK_PATCH_ROOT=/opt/oh-sdk-patch
#OH_SDK_RESTORE_TASK_ENV=1
LLM_TIMEOUT=1200

# --- template composition ---------------------------------------------
TEMPLATE_MODULES=(
  runtime/process.env
  eval/common.env
  eval/vllm.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
