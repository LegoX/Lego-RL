# scripts/eval/configs/qwen36-27b_official_verified.env
# Filled config converted from scripts/eval_qwen36_27b_official_verified.sh.

# --- template selection -----------------------------------------------
BACKEND=k8s
SCAFFOLD=ohsdk

# --- identity ----------------------------------------------------------
PROJECT_NAME=eval-qwen36-27b-verified
EXP_NAME=eval-qwen36-27b-verified-$(date +%Y%m%d-%H%M%S)
POD_PREFIX=q36v
STEP_TAG=verified

# --- runtime -----------------------------------------------------------
VENV_PATH=/root/code/.venv
EVAL_EXTRA_PYTHONPATH=/path/to/eval_shims:/path/to/harbor/src

# --- model/dataset -----------------------------------------------------
MODEL_PATH=/path/to/models/Qwen3.6-27B
DATASET_PATH=/path/to/shared/harbor_swe_val_tasks_official
TOOL_CALL_PARSER=qwen3_coder
HARBOR_AGENT_PARSER_NAME=qwen3_coder

# --- sampling/context --------------------------------------------------
EVAL_TEMPERATURE=1.0
MAX_INPUT_TOKENS=200000
MAX_OUTPUT_TOKENS=32768
MAX_MODEL_LEN=262144

# --- vLLM serving ------------------------------------------------------
GEN_TP=8
GPU_MEM_UTIL=0.9
VLLM_PORT=8000
EVAL_ENABLE_EXPERT_PARALLEL=false
EVAL_VLLM_EXTRA_ARGS="--enforce-eager --enable-chunked-prefill --enable-prefix-caching --dtype bfloat16"
EVAL_VLLM_READY_ITERS=360

# --- harbor/backend overrides -----------------------------------------
N_CONCURRENT=16
MAX_RETRIES=2
HARBOR_AGENT_MAX_ITERATIONS=200
HARBOR_AGENT_MAX_TIMEOUT_SEC=7200
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=7200
HARBOR_AGENT_RUNTIME_IMAGE=docker.io/jierun/c-oh-sdk-1.14.0:v0.1
HARBOR_HOSTPATH_MOUNTS='[{"host_path":"/path/to/node-local/swe-rebench-v2-c71902a","mount_path":"/opt/rebench-v2","read_only":true}]'
K8S_KUBECONFIG=$HOME/.kube/config
K8S_POD_ACTIVE_DEADLINE_SECONDS=8400

# --- template composition ---------------------------------------------
TEMPLATE_MODULES=(
  runtime/process.env
  eval/common.env
  eval/vllm.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
