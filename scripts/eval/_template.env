# scripts/eval/_template.env
# Copy this file to scripts/eval/configs/<experiment>.env, then replace every
# CHANGEME value before running scripts/eval/eval.sh.

# --- template selection -----------------------------------------------
BACKEND=CHANGEME        # k8s | docker
SCAFFOLD=CHANGEME       # ohsdk | oh | cc | oc

# --- identity ----------------------------------------------------------
PROJECT_NAME=CHANGEME
EXP_NAME=CHANGEME

# --- runtime -----------------------------------------------------------
VENV_PATH=CHANGEME

# --- model -------------------------------------------------------------
MODEL_PATH=CHANGEME
# TOOL_CALL_PARSER=hermes

# --- dataset -----------------------------------------------------------
# Set exactly one of DATASET_PATH or DATASET_NAME.
DATASET_PATH=CHANGEME
# DATASET_NAME=swebench-verified

# Required when BACKEND=k8s.
K8S_KUBECONFIG=CHANGEME

# --- optional eval overrides ------------------------------------------
# N_TASKS=500
# EVAL_AGENT_NAME=oh-sdk
# N_CONCURRENT=16
# MAX_RETRIES=2
# EVAL_TEMPERATURE=0.7
# MAX_INPUT_TOKENS=40000
# MAX_OUTPUT_TOKENS=91072
# MAX_MODEL_LEN=131072
# GEN_TP=4
# GPU_MEM_UTIL=0.85
# VLLM_PORT=8000
# EVAL_ENABLE_EXPERT_PARALLEL=true
# EVAL_VLLM_EXTRA_ARGS="--enable-chunked-prefill --dtype bfloat16"
# EVAL_VLLM_READY_ITERS=120
# HARBOR_AGENT_MAX_TIMEOUT_SEC=2400
# HARBOR_AGENT_RUNTIME_IMAGE=docker.io/jierun/c-oh-sdk-1.14.0:v0.1
# HARBOR_HOSTPATH_MOUNTS='[{"host_path":"/path/to/node-local/swe-rebench-v2-c71902a","mount_path":"/opt/rebench-v2","read_only":true}]'

# --- template composition ---------------------------------------------
# Keep this after explicit settings because module paths and derived defaults
# depend on values above.
TEMPLATE_MODULES=(
  runtime/process.env
  eval/common.env
  eval/vllm.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
