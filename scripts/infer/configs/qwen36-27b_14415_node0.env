# scripts/infer/configs/qwen36-27b_14415_node0.env
# Live config converted to the template-based infer runner.
# Run: scripts/infer/infer.sh scripts/infer/configs/qwen36-27b_14415_node0.env

# --- template selection -----------------------------------------------
BACKEND=k8s
SCAFFOLD=ohsdk

# --- identity ----------------------------------------------------------
PROJECT_NAME=infer-14415
EXP_NAME=node0-$(date +%Y%m%d-%H%M%S)

# --- runtime -----------------------------------------------------------
VENV_PATH=/path/to/SWE-Lego-RL/.venv

# --- model -------------------------------------------------------------
MODEL_PATH=/path/to/models/Qwen3.6-27B
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=hosted_vllm/${SERVED_MODEL_NAME}

# --- data/output -------------------------------------------------------
INDEX_FILE=/path/to/shared/train_openswe_filtered.parquet
INSTANCES_FILE=/path/to/shared/infer_14415/shards/shard0_kept2443.txt
RESULTS_DIR=/path/to/shared/infer_14415/results/node0
OUTPUT_INDEX=/path/to/shared/infer_14415/selected/train_openswe_14415_selected_node0.parquet

# --- rollout -----------------------------------------------------------
N_TRIALS=4
N_CONCURRENT=40
TEMPERATURE=1.0
TRIAL_HARD_TIMEOUT_SEC=4500
HARBOR_AGENT_MAX_TIMEOUT_SEC=3000

# --- vLLM single-node serving -----------------------------------------------------
GEN_TP=8
GPUS_PER_NODE=8
VLLM_MAX_MODEL_LEN=200000
MAX_RESPONSE_LEN=32768
VLLM_PORT=8011

# --- backend/scaffold/site overrides ----------------------------------
K8S_KUBECONFIG=$HOME/.kube/config
HARBOR_AGENT_RUNTIME_IMAGE=docker.io/jierun/c-oh-sdk-1.14.0:v0.1
HARBOR_OPENSWE_BASE_REGISTRY=chaofantao
HARBOR_HOSTPATH_NODE_REWRITE=/path/to/shared:/path/to/node-local
HARBOR_HOSTPATH_MOUNTS=null
HARBOR_K8S_INLINE_BUILD=true
HARBOR_OPENSWE_SKIP_DOCKERFILE=false

# --- template composition ---------------------------------------------
TEMPLATE_MODULES=(
  runtime/process.env
  infer/vllm.env
  infer/common.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
