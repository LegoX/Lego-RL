# scripts/infer/configs/infer_openswe_filtered_ohsdk_qwen3_6_27b_completed4trials.env
# Filled config mirrored from scripts/infer_openswe_filtered_ohsdk_qwen3_6_27b_completed4trials.sh.
# This file is intentionally explicit: do not use environment fallbacks here.

# --- template selection -----------------------------------------------
BACKEND=k8s
SCAFFOLD=ohsdk

# --- identity ----------------------------------------------------------
PROJECT_NAME=infer-openswe-filtered-ohsdk-qwen3-6-27b-completed4trials
EXP_NAME=completed4trials-$(date +%Y%m%d-%H%M%S)

# --- runtime -----------------------------------------------------------
VENV_PATH=/path/to/Lego-RL/.venv

# --- model -------------------------------------------------------------
MODEL_PATH=/path/to/models/Qwen3.6-27B
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=hosted_vllm/${SERVED_MODEL_NAME}

# --- data/output -------------------------------------------------------
INDEX_FILE=/path/to/data/harbor_indexes/train_openswe_filtered.parquet
INSTANCES_FILE=/path/to/shared/test_data_bcd/completed_4trials_instances.txt
RESULTS_DIR=/path/to/shared/test_data_bcd/infer_openswe_filtered_qwen3_6_27b_ohsdk_completed4trials
OUTPUT_INDEX=/path/to/data/harbor_indexes/train_openswe_filtered_selected_ohsdk_qwen3_6_27b_completed4trials.parquet

# --- rollout -----------------------------------------------------------
N_TRIALS=4
N_CONCURRENT=80
TEMPERATURE=1.0
TRIAL_HARD_TIMEOUT_SEC=4500
HARBOR_AGENT_MAX_ITERATIONS=200
HARBOR_AGENT_MAX_TIMEOUT_SEC=3000
HARBOR_ENV_START_MAX_ATTEMPTS=1

# --- vLLM single-node serving -----------------------------------------------------
GEN_TP=8
GPUS_PER_NODE=8
VLLM_PORT=8011
VLLM_API_SERVER_COUNT=1
VLLM_MAX_MODEL_LEN=128000
MAX_RESPONSE_LEN=32768
GPU_MEM_UTIL=0.85
PREFIX_CACHING_HASH_ALGO=sha256

# --- backend/scaffold/site overrides ----------------------------------
K8S_KUBECONFIG=$HOME/.kube/config
K8S_NAMESPACE=default
HARBOR_AGENT_RUNTIME_IMAGE=docker.io/jierun/c-oh-sdk-1.14.0:v0.1
HARBOR_OPENSWE_BASE_REGISTRY=chaofantao
HARBOR_HOSTPATH_NODE_REWRITE=/path/to/shared:/path/to/node-local
HARBOR_HOSTPATH_MOUNTS=null
HARBOR_K8S_INLINE_BUILD=true
HARBOR_OPENSWE_SKIP_DOCKERFILE=false

# --- template composition ---------------------------------------------
# Keep this after explicit settings because module paths and derived defaults
# depend on values above.
TEMPLATE_MODULES=(
  runtime/process.env
  infer/vllm.env
  infer/common.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
