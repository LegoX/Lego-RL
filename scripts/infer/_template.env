# scripts/infer/_template.env
# Copy this file to scripts/infer/configs/<experiment>.env, then replace every
# CHANGEME value before running scripts/infer/infer.sh.

# --- template selection -----------------------------------------------
BACKEND=CHANGEME        # k8s | docker
SCAFFOLD=CHANGEME       # ohsdk | oh | cc | oc

# --- identity ----------------------------------------------------------
PROJECT_NAME=CHANGEME
EXP_NAME=CHANGEME

# --- runtime -----------------------------------------------------------
VENV_PATH=CHANGEME

# --- model -------------------------------------------------------------
MODEL_PATH=CHANGEME
TOOL_CALL_PARSER=CHANGEME

# --- data/output -------------------------------------------------------
INDEX_FILE=CHANGEME
RESULTS_DIR=CHANGEME
OUTPUT_INDEX=CHANGEME

# Required when BACKEND=k8s.
K8S_KUBECONFIG=CHANGEME

# --- optional infer overrides ------------------------------------------
# INSTANCES_FILE=/path/to/instances.txt
# N_TRIALS=4
# N_CONCURRENT=80
# TEMPERATURE=1.0
# TRIAL_HARD_TIMEOUT_SEC=4500
# GEN_TP=4
# GPUS_PER_NODE=8
# VLLM_MAX_MODEL_LEN=128000
# MAX_RESPONSE_LEN=32768
# VLLM_PORT=8011

# --- optional site/backend values -------------------------------------
# HARBOR_OPENSWE_IMAGE_REGISTRY=CHANGEME
# HARBOR_NYDUS_MIRROR=CHANGEME
# HARBOR_HOSTPATH_NODE_REWRITE=CHANGEME
# HARBOR_AGENT_RUNTIME_IMAGE=CHANGEME

# --- template composition ---------------------------------------------
# Keep this after explicit settings because module paths and derived defaults
# depend on values above.
TEMPLATE_MODULES=(
  runtime/process.env
  infer/vllm.env
  infer/common.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
