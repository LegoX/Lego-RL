# module: eval/common
# Shared Harbor-native offline eval defaults for scripts/eval/eval.sh.

# --- identity ----------------------------------------------------------
: "${PROJECT_NAME:?PROJECT_NAME is required}"
: "${EXP_NAME:?EXP_NAME is required}"

# --- model/dataset -----------------------------------------------------
: "${MODEL_PATH:?MODEL_PATH is required}"
: "${SERVED_MODEL_NAME:=vllm_model}"
: "${TOOL_CALL_PARSER:=hermes}"
: "${DATASET_PATH:=}"
: "${DATASET_NAME:=}"
: "${N_TASKS:=}"

# --- sampling/context --------------------------------------------------
: "${EVAL_TEMPERATURE:=0.7}"
: "${MAX_INPUT_TOKENS:=40000}"
: "${MAX_OUTPUT_TOKENS:=91072}"
: "${MAX_MODEL_LEN:=$((MAX_INPUT_TOKENS + MAX_OUTPUT_TOKENS))}"

# --- harbor job --------------------------------------------------------
: "${EVAL_AGENT_NAME:=oh-sdk}"
: "${HARBOR_AGENT_MODEL_INFO:={max_input_tokens: ${MAX_INPUT_TOKENS}, max_output_tokens: ${MAX_OUTPUT_TOKENS}, input_cost_per_token: 0, output_cost_per_token: 0\}}"
: "${HARBOR_AGENT_TEMPERATURE:=${EVAL_TEMPERATURE}}"
: "${HARBOR_AGENT_MAX_TIMEOUT_SEC:=2400}"
: "${HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC:=${HARBOR_AGENT_MAX_TIMEOUT_SEC}}"
: "${HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB:=4096}"
: "${HARBOR_HOSTPATH_MOUNTS:=null}"
: "${HARBOR_MAX_RETRIES:=${MAX_RETRIES:-2}}"
: "${HARBOR_POD_NAME_PREFIX:=${POD_PREFIX:-hn}-s${STEP_TAG:-x}}"
: "${HARBOR_VERIFIER_ENABLED:=True}"
: "${MAX_RETRIES:=${HARBOR_MAX_RETRIES}}"
: "${N_CONCURRENT:=16}"

# --- logs/artifacts ----------------------------------------------------
: "${EVAL_LOG_DIR:=${REPO_ROOT:?REPO_ROOT is required}/logs}"
: "${EVAL_JOBS_DIR:=${REPO_ROOT}/harbor_trials}"
: "${EVAL_LOG:=${EVAL_LOG_DIR}/${EXP_NAME}.log}"
: "${VLLM_LOG:=${EVAL_LOG_DIR}/${EXP_NAME}_vllm.log}"
: "${JOB_CFG:=/tmp/harbor_job_${EXP_NAME}.json}"
