# module: eval/vllm
# Single-node plain-vLLM serving defaults for Harbor-native offline eval.

: "${VLLM_USE_V1:=1}"
: "${VLLM_WORKER_MULTIPROC_METHOD:=spawn}"
: "${GEN_TP:=4}"
: "${GPU_MEM_UTIL:=0.85}"
: "${VLLM_PORT:=8000}"
: "${VLLM_BIND_HOST:=0.0.0.0}"
: "${EVAL_ENABLE_EXPERT_PARALLEL:=true}"
: "${EVAL_VLLM_EXTRA_ARGS:=}"
: "${EVAL_VLLM_READY_ITERS:=120}"
: "${NODE0_IP:=$(hostname -I | awk '{print $1}')}"
: "${API_BASE:=http://${NODE0_IP}:${VLLM_PORT}/v1}"
: "${LLM_BASE_URL:=${API_BASE}}"
: "${LLM_API_KEY:=dummy}"
