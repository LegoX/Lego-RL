# module: scaffold/ohsdk
# OpenHands SDK mounted-runtime scaffold defaults.
: "${AGENT_LOOP_CONFIG_PATH:=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_oh.yaml}"
: "${HARBOR_AGENT_IMPORT_PATH:=harbor.agents.custom.openhands_sdk:CustomOpenHandsSDK}"
: "${HARBOR_AGENT_NAME:=null}"
: "${HARBOR_AGENT_RUNTIME_IMAGE:=docker.io/jierun/c-oh-sdk-1.33.0:v0.1}"
: "${HARBOR_AGENT_RUNTIME_IMAGE_SUBPATH:=opt/custom-agent-runtime/oh-sdk}"
: "${HARBOR_AGENT_RUNTIME_MOUNT_PATH:=/opt/custom-agent-runtime/oh-sdk}"
: "${HARBOR_AGENT_VERSION:=1.33.0}"

: "${HARBOR_HARNESS_PROTOCOL:=openai}"
if [ -z "${HARBOR_HARNESS_MODEL_TEMPLATE:-}" ]; then HARBOR_HARNESS_MODEL_TEMPLATE='hosted_vllm/{served}'; fi
if [ -z "${HARBOR_HARNESS_ENDPOINT_TEMPLATE:-}" ]; then HARBOR_HARNESS_ENDPOINT_TEMPLATE='{llm_base}'; fi
: "${HARBOR_HARNESS_ALLOW_ENDPOINT_HOST:=true}"
if [ -z "${HARBOR_HARNESS_KWARGS_MAP:-}" ]; then HARBOR_HARNESS_KWARGS_MAP='{"api_base":"{llm_base}","temperature":"{temperature}"}'; fi
if [ -z "${HARBOR_HARNESS_ENV_MAP:-}" ]; then HARBOR_HARNESS_ENV_MAP='{"LLM_BASE_URL":"{llm_base}","LLM_API_KEY":"{llm_key}","LLM_MODEL":"hosted_vllm/{served}","CUSTOM_AGENT_RUNTIME_ROOT":"{env:HARBOR_AGENT_RUNTIME_MOUNT_PATH}"}'; fi
if [ -z "${HARBOR_HARNESS_RENDER_CONTRACT:-}" ]; then HARBOR_HARNESS_RENDER_CONTRACT="$(HARBOR_HARNESS_MODEL_TEMPLATE="$HARBOR_HARNESS_MODEL_TEMPLATE" HARBOR_HARNESS_ENDPOINT_TEMPLATE="$HARBOR_HARNESS_ENDPOINT_TEMPLATE" HARBOR_HARNESS_KWARGS_MAP="$HARBOR_HARNESS_KWARGS_MAP" HARBOR_HARNESS_ENV_MAP="$HARBOR_HARNESS_ENV_MAP" HARBOR_HARNESS_ALLOW_ENDPOINT_HOST="$HARBOR_HARNESS_ALLOW_ENDPOINT_HOST" python3 -c 'import json,os; print(json.dumps({"model_template":os.environ["HARBOR_HARNESS_MODEL_TEMPLATE"],"endpoint_template":os.environ["HARBOR_HARNESS_ENDPOINT_TEMPLATE"],"kwargs":json.loads(os.environ["HARBOR_HARNESS_KWARGS_MAP"]),"env":json.loads(os.environ["HARBOR_HARNESS_ENV_MAP"]),"allow_endpoint_host":os.environ["HARBOR_HARNESS_ALLOW_ENDPOINT_HOST"].lower() in {"1","true","yes","on"}},separators=(",",":")))')"; fi
export HARBOR_HARNESS_PROTOCOL HARBOR_HARNESS_MODEL_TEMPLATE HARBOR_HARNESS_ENDPOINT_TEMPLATE \
       HARBOR_HARNESS_ALLOW_ENDPOINT_HOST HARBOR_HARNESS_KWARGS_MAP HARBOR_HARNESS_ENV_MAP \
       HARBOR_HARNESS_RENDER_CONTRACT
