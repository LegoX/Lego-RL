# module: scaffold/cx
# Codex CLI. OpenAI Responses surface; base_url injected per-session by the loop.
#
# Codex speaks ONLY the Responses API — codex-cli 0.122.0 (2026-04-20) turned a
# `wire_api = "chat"` config into a hard startup error, and the protocol was
# deprecated 2026-02-01. The proxy serves /sess/{id}/v1/responses for it.
: "${AGENT_LOOP_CONFIG_PATH:=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_cx.yaml}"
# AGENT_NAME must be null so harbor's factory dispatches on import_path and our
# mounted-runtime subclass is used; setting it to "codex" silently selects
# harbor.agents.installed.codex:Codex, which installs in-pod via nvm+npm (needs
# pod egress, does not survive 96 workers) — see preflight block 6.
: "${HARBOR_AGENT_NAME:=null}"
: "${HARBOR_AGENT_IMPORT_PATH:=harbor_patch.agents.image_mounted_codex:Codex}"
# Set a registry image built by scripts/agent_runtimes/codex/0.153.4.
# null uses Harbor's pinned installer and requires sandbox network access.
: "${HARBOR_AGENT_RUNTIME_IMAGE:=null}"
: "${HARBOR_AGENT_RUNTIME_MOUNT_PATH:=/opt/custom-agent-runtime/codex}"
: "${HARBOR_AGENT_RUNTIME_IMAGE_SUBPATH:=opt/custom-agent-runtime/codex}"
# Pinned exactly, and asserted against the mounted binary at setup: a drifted
# image would train against a different harness than the config claims. Built by
# scripts/agent_runtimes/codex/0.153.4/build-runtime-image.sh.
: "${HARBOR_AGENT_VERSION:=0.153.4}"
: "${HARBOR_OPENAI_BASE_URL:=http://in-process-proxy/v1}"
: "${HARBOR_OPENAI_API_KEY:=sk-dummy}"
# Codex sends `reasoning` items back on every later turn; the proxy round-trips
# them through encrypted_content. "none" turns the whole reasoning path off.
: "${CODEX_REASONING_EFFORT:=medium}"
