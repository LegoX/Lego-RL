# module: scaffold/oc
: "${AGENT_LOOP_CONFIG_PATH:=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_oh.yaml}"
: "${HARBOR_AGENT_NAME:=null}"
: "${HARBOR_AGENT_IMPORT_PATH:=harbor_patch.agents.image_mounted_opencode:OpenCode}"
: "${HARBOR_AGENT_RUNTIME_IMAGE:=docker.io/jierun/c-oc-1.14.22:v0.1}"
: "${HARBOR_AGENT_RUNTIME_MOUNT_PATH:=/opt/custom-agent-runtime/opencode}"
: "${HARBOR_AGENT_RUNTIME_IMAGE_SUBPATH:=opt/custom-agent-runtime/opencode}"
: "${HARBOR_AGENT_VERSION:=1.14.22}"
: "${HARBOR_OPENAI_BASE_URL:=http://in-process-proxy/v1}"
: "${HARBOR_OPENAI_API_KEY:=sk-dummy}"
: "${HARBOR_CUSTOM_AGENT_OPENCODE:=/opt/custom-agent-runtime/opencode/bin/opencode}"
: "${HARBOR_CUSTOM_AGENT_RUNTIME_ENV_SCRIPT:=/opt/custom-agent-runtime/opencode/runtime-env.sh}"

: "${OPENCODE_DISABLE_STREAMING:=true}"

if [ -z "${HARBOR_OPENCODE_CONFIG_CONTENT:-}" ]; then
    HARBOR_OPENCODE_CONFIG_CONTENT="$(
        SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-vllm_model}" \
        OPENCODE_DISABLE_STREAMING="${OPENCODE_DISABLE_STREAMING}" \
        python3 - <<'PYOPENCODE'
import json
import os

served = os.environ["SERVED_MODEL_NAME"]
opencode_model = f"hosted_vllm/{served}"
max_steps = int(os.environ.get("HARBOR_AGENT_MAX_ITERATIONS", 200))
disable_streaming = os.environ["OPENCODE_DISABLE_STREAMING"].lower() in {"1", "true", "yes", "on"}
options = {
    "baseURL": "{env:HOSTED_VLLM_BASE_URL}",
    "apiKey": "{env:HOSTED_VLLM_API_KEY}",
    "headers": {
        "x-harbor-temperature": "{env:OPENCODE_TEMPERATURE}",
    },
}
if disable_streaming:
    options["disableStreaming"] = True
print(json.dumps({
    "$schema": "https://opencode.ai/config.json",
    "model": opencode_model,
    "small_model": opencode_model,
    "enabled_providers": ["hosted_vllm"],
    "provider": {
        "hosted_vllm": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Hosted vLLM",
            "options": options,
            "models": {
                served: {"name": served},
            },
        },
    },
    "agent": {
        "build":{"steps": max_steps},
        "title": {"model": opencode_model},
        "summary": {"model": opencode_model},
        "compaction": {"model": opencode_model},
    },
}, separators=(",", ":")))
PYOPENCODE
    )"
fi
export HARBOR_OPENCODE_CONFIG_CONTENT

# Shared harness contract consumed by both the training-side endpoint injector
# and the eval-side JobConfig renderer.  The endpoint value is supplied by the
# caller (per-session proxy during training, plain vLLM during eval).  Define
# this after HARBOR_OPENCODE_CONFIG_CONTENT because the env map references it.
: "${HARBOR_HARNESS_PROTOCOL:=openai}"
if [ -z "${HARBOR_HARNESS_MODEL_TEMPLATE:-}" ]; then HARBOR_HARNESS_MODEL_TEMPLATE='hosted_vllm/{served}'; fi
if [ -z "${HARBOR_HARNESS_ENDPOINT_TEMPLATE:-}" ]; then HARBOR_HARNESS_ENDPOINT_TEMPLATE='{llm_base}'; fi
: "${HARBOR_HARNESS_ALLOW_ENDPOINT_HOST:=true}"
if [ -z "${HARBOR_HARNESS_KWARGS_MAP:-}" ]; then HARBOR_HARNESS_KWARGS_MAP='{"api_base":"{llm_base}","temperature":"{temperature}"}'; fi
if [ -z "${HARBOR_HARNESS_ENV_MAP:-}" ]; then HARBOR_HARNESS_ENV_MAP='{"LLM_BASE_URL":"{llm_base}","LLM_API_KEY":"{llm_key}","HOSTED_VLLM_BASE_URL":"{llm_base}","HOSTED_VLLM_API_KEY":"{llm_key}","OPENCODE_TEMPERATURE":"{temperature}","OPENCODE_CONFIG_CONTENT":"{env:HARBOR_OPENCODE_CONFIG_CONTENT}","LLM_MODEL":"hosted_vllm/{served}","CUSTOM_AGENT_RUNTIME_ROOT":"{env:HARBOR_AGENT_RUNTIME_MOUNT_PATH}","CUSTOM_AGENT_OPENCODE":"{env:HARBOR_CUSTOM_AGENT_OPENCODE}","CUSTOM_AGENT_RUNTIME_ENV_SCRIPT":"{env:HARBOR_CUSTOM_AGENT_RUNTIME_ENV_SCRIPT}"}'; fi
if [ -z "${HARBOR_HARNESS_RENDER_CONTRACT:-}" ]; then
    HARBOR_HARNESS_RENDER_CONTRACT="$(HARBOR_HARNESS_MODEL_TEMPLATE="$HARBOR_HARNESS_MODEL_TEMPLATE" HARBOR_HARNESS_ENDPOINT_TEMPLATE="$HARBOR_HARNESS_ENDPOINT_TEMPLATE" HARBOR_HARNESS_KWARGS_MAP="$HARBOR_HARNESS_KWARGS_MAP" HARBOR_HARNESS_ENV_MAP="$HARBOR_HARNESS_ENV_MAP" HARBOR_HARNESS_ALLOW_ENDPOINT_HOST="$HARBOR_HARNESS_ALLOW_ENDPOINT_HOST" python3 - <<'PYCONTRACT'
import json, os
print(json.dumps({
    "model_template": os.environ["HARBOR_HARNESS_MODEL_TEMPLATE"],
    "endpoint_template": os.environ["HARBOR_HARNESS_ENDPOINT_TEMPLATE"],
    "kwargs": json.loads(os.environ["HARBOR_HARNESS_KWARGS_MAP"]),
    "env": json.loads(os.environ["HARBOR_HARNESS_ENV_MAP"]),
    "allow_endpoint_host": os.environ["HARBOR_HARNESS_ALLOW_ENDPOINT_HOST"].lower() in {"1", "true", "yes", "on"},
}, separators=(",", ":")))
PYCONTRACT
    )"
fi
export HARBOR_HARNESS_PROTOCOL HARBOR_HARNESS_MODEL_TEMPLATE HARBOR_HARNESS_ENDPOINT_TEMPLATE \
       HARBOR_HARNESS_ALLOW_ENDPOINT_HOST HARBOR_HARNESS_KWARGS_MAP HARBOR_HARNESS_ENV_MAP \
       HARBOR_HARNESS_RENDER_CONTRACT
