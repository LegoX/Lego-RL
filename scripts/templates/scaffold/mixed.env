# module: scaffold/mixed
# One worker-level proxy serves all configured harnesses. Per-harness agent
# images/import paths are owned by agent_loop_config_mixed.yaml.
: "${AGENT_LOOP_CONFIG_PATH:=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_mixed.yaml}"
: "${HARBOR_AGENT_NAME:=null}"
: "${HARBOR_HARNESS_DEFAULT:=openhands_sdk}"
# Keep validation on one stable harness; override per experiment when needed.
: "${HARBOR_VAL_HARNESS:=openhands_sdk}"
: "${HARBOR_HARNESS_FALLBACK:=weighted_random}"
: "${HARBOR_HARNESS_GRANULARITY:=task}"
: "${HARBOR_HARNESS_RANDOM_SEED:=1234}"
: "${HARBOR_HARNESS_WEIGHT_OHSDK:=1.0}"
: "${HARBOR_HARNESS_WEIGHT_OC:=1.0}"
: "${HARBOR_HARNESS_WEIGHT_CC:=1.0}"

# OpenCode still needs its in-pod provider document even though the session URL
# is injected later by BuiltinSWEAgentLoop.
: "${OPENCODE_DISABLE_STREAMING:=true}"
if [ -z "${HARBOR_OPENCODE_CONFIG_CONTENT:-}" ]; then
    HARBOR_OPENCODE_CONFIG_CONTENT="$(
        SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-vllm_model}" \
        OPENCODE_DISABLE_STREAMING="$OPENCODE_DISABLE_STREAMING" \
        python3 - <<'PYOPENCODE'
import json
import os

served = os.environ["SERVED_MODEL_NAME"]
model = f"hosted_vllm/{served}"
max_steps = int(os.environ.get("HARBOR_AGENT_MAX_ITERATIONS", 200))
options = {
    "baseURL": "{env:HOSTED_VLLM_BASE_URL}",
    "apiKey": "{env:HOSTED_VLLM_API_KEY}",
    "headers": {"x-harbor-temperature": "{env:OPENCODE_TEMPERATURE}"},
}
if os.environ["OPENCODE_DISABLE_STREAMING"].lower() in {"1", "true", "yes", "on"}:
    options["disableStreaming"] = True
print(json.dumps({
    "$schema": "https://opencode.ai/config.json",
    "model": model,
    "small_model": model,
    "enabled_providers": ["hosted_vllm"],
    "provider": {"hosted_vllm": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "Hosted vLLM",
        "options": options,
        "models": {served: {"name": served}},
    }},
    "agent": {
        "build": {"steps": max_steps},
        "title": {"model": model},
        "summary": {"model": model},
        "compaction": {"model": model},
    },
}, separators=(",", ":")))
PYOPENCODE
    )"
fi
export HARBOR_OPENCODE_CONFIG_CONTENT HARBOR_HARNESS_DEFAULT HARBOR_VAL_HARNESS \
       HARBOR_HARNESS_FALLBACK HARBOR_HARNESS_GRANULARITY \
       HARBOR_HARNESS_RANDOM_SEED HARBOR_HARNESS_WEIGHT_OHSDK \
       HARBOR_HARNESS_WEIGHT_OC HARBOR_HARNESS_WEIGHT_CC
