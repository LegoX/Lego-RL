# module: scaffold/cc
: "${AGENT_LOOP_CONFIG_PATH:=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_cc.yaml}"
: "${HARBOR_AGENT_NAME:=null}"
: "${HARBOR_AGENT_IMPORT_PATH:=harbor_patch.agents.image_mounted_claude_code:ClaudeCode}"
: "${HARBOR_AGENT_RUNTIME_IMAGE:=docker.io/jierun/c-cc-2.1.118:v0.1}"
: "${HARBOR_AGENT_RUNTIME_MOUNT_PATH:=/opt/custom-agent-runtime/claude-code}"
: "${HARBOR_AGENT_RUNTIME_IMAGE_SUBPATH:=opt/custom-agent-runtime/claude-code}"
: "${HARBOR_AGENT_VERSION:=2.1.118}"

: "${HARBOR_CUSTOM_AGENT_CLAUDE:=${HARBOR_AGENT_RUNTIME_MOUNT_PATH}/bin/claude}"
: "${HARBOR_CUSTOM_AGENT_RUNTIME_ENV_SCRIPT:=${HARBOR_AGENT_RUNTIME_MOUNT_PATH}/runtime-env.sh}"

# Claude Code uses Anthropic Messages; the SDK appends /v1/messages itself.
: "${HARBOR_HARNESS_PROTOCOL:=anthropic}"
if [ -z "${HARBOR_HARNESS_MODEL_TEMPLATE:-}" ]; then HARBOR_HARNESS_MODEL_TEMPLATE='{served}'; fi
if [ -z "${HARBOR_HARNESS_ENDPOINT_TEMPLATE:-}" ]; then HARBOR_HARNESS_ENDPOINT_TEMPLATE='{llm_base_no_v1}'; fi
: "${HARBOR_HARNESS_ALLOW_ENDPOINT_HOST:=true}"
if [ -z "${HARBOR_HARNESS_KWARGS_MAP:-}" ]; then HARBOR_HARNESS_KWARGS_MAP='{"temperature":"{temperature}"}'; fi
if [ -z "${HARBOR_HARNESS_ENV_MAP:-}" ]; then HARBOR_HARNESS_ENV_MAP='{"ANTHROPIC_BASE_URL":"{llm_base_no_v1}","ANTHROPIC_API_KEY":"{anthropic_key}","ANTHROPIC_MODEL":"{served}","CLAUDE_CODE_ATTRIBUTION_HEADER":"0","CUSTOM_AGENT_RUNTIME_ROOT":"{env:HARBOR_AGENT_RUNTIME_MOUNT_PATH}","CUSTOM_AGENT_CLAUDE":"{env:HARBOR_CUSTOM_AGENT_CLAUDE}","CUSTOM_AGENT_RUNTIME_ENV_SCRIPT":"{env:HARBOR_CUSTOM_AGENT_RUNTIME_ENV_SCRIPT}"}'; fi
if [ -z "${HARBOR_HARNESS_RENDER_CONTRACT:-}" ]; then HARBOR_HARNESS_RENDER_CONTRACT="$(HARBOR_HARNESS_MODEL_TEMPLATE="$HARBOR_HARNESS_MODEL_TEMPLATE" HARBOR_HARNESS_ENDPOINT_TEMPLATE="$HARBOR_HARNESS_ENDPOINT_TEMPLATE" HARBOR_HARNESS_KWARGS_MAP="$HARBOR_HARNESS_KWARGS_MAP" HARBOR_HARNESS_ENV_MAP="$HARBOR_HARNESS_ENV_MAP" HARBOR_HARNESS_ALLOW_ENDPOINT_HOST="$HARBOR_HARNESS_ALLOW_ENDPOINT_HOST" python3 -c 'import json,os; print(json.dumps({"model_template":os.environ["HARBOR_HARNESS_MODEL_TEMPLATE"],"endpoint_template":os.environ["HARBOR_HARNESS_ENDPOINT_TEMPLATE"],"kwargs":json.loads(os.environ["HARBOR_HARNESS_KWARGS_MAP"]),"env":json.loads(os.environ["HARBOR_HARNESS_ENV_MAP"]),"allow_endpoint_host":os.environ["HARBOR_HARNESS_ALLOW_ENDPOINT_HOST"].lower() in {"1","true","yes","on"}},separators=(",",":")))')"; fi
export HARBOR_CUSTOM_AGENT_CLAUDE HARBOR_CUSTOM_AGENT_RUNTIME_ENV_SCRIPT \
       HARBOR_HARNESS_PROTOCOL HARBOR_HARNESS_MODEL_TEMPLATE HARBOR_HARNESS_ENDPOINT_TEMPLATE \
       HARBOR_HARNESS_ALLOW_ENDPOINT_HOST HARBOR_HARNESS_KWARGS_MAP HARBOR_HARNESS_ENV_MAP \
       HARBOR_HARNESS_RENDER_CONTRACT
