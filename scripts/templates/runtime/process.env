# module: runtime/process
# Process-level runtime knobs shared by train, eval, and infer workloads.
: "${GLOO_SOCKET_IFNAME:=eth0}"
: "${TP_SOCKET_IFNAME:=eth0}"
: "${NCCL_SOCKET_IFNAME:=eth0}"
: "${NCCL_DEBUG:=WARN}"
: "${DOCKER_BUILDKIT:=1}"
: "${TOKENIZERS_PARALLELISM:=false}"
: "${RAYON_NUM_THREADS:=1}"
: "${VLLM_LOGGING_LEVEL:=INFO}"
: "${HARBOR_RECOMPUTE_MISMATCH_LOGPROBS:=0}"

: "${VENV_PATH:?VENV_PATH is required}"
: "${RAY_PORT:=6379}"
: "${RAY_DASHBOARD_PORT:=8265}"
: "${RAY_OBJECT_STORE_MEMORY:=40000000000}"
