# module: infer/vllm
# Single-node vLLM serving defaults for infer/rollout jobs.

: "${VLLM_USE_V1:=1}"
: "${VLLM_WORKER_MULTIPROC_METHOD:=spawn}"
: "${GEN_TP:=4}"
: "${GPUS_PER_NODE:=8}"
: "${VLLM_MAX_MODEL_LEN:=128000}"
: "${GPU_MEM_UTIL:=0.85}"
: "${PREFIX_CACHING_HASH_ALGO:=sha256}"
: "${VLLM_PORT:=8011}"
: "${VLLM_BIND_HOST:=0.0.0.0}"
: "${VLLM_API_SERVER_COUNT:=1}"
: "${VLLM_READY_TIMEOUT:=900}"
: "${API_BASE:=http://127.0.0.1:${VLLM_PORT}/v1}"
: "${LLM_BASE_URL:=${API_BASE}}"
: "${LLM_API_KEY:=dummy-key-for-local-vllm}"
