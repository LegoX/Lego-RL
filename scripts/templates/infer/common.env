# module: infer/common
# Shared infer/rollout defaults for scripts/infer/infer.sh.

# --- identity ----------------------------------------------------------
: "${PROJECT_NAME:?PROJECT_NAME is required}"
: "${EXP_NAME:?EXP_NAME is required}"

# --- data/output -------------------------------------------------------
: "${INDEX_FILE:?INDEX_FILE is required}"
: "${INSTANCES_FILE:=}"
: "${RESULTS_DIR:?RESULTS_DIR is required}"
: "${OUTPUT_INDEX:?OUTPUT_INDEX is required}"

# --- rollout -----------------------------------------------------------
: "${N_TRIALS:=4}"
: "${N_CONCURRENT:=80}"
: "${TEMPERATURE:=1.0}"
: "${TRIAL_HARD_TIMEOUT_SEC:=4500}"

# --- model -------------------------------------------------------------
: "${MODEL_PATH:?MODEL_PATH is required}"
: "${SERVED_MODEL_NAME:=vllm_model}"
: "${TOOL_CALL_PARSER:?TOOL_CALL_PARSER is required}"
: "${AGENT_MODEL_NAME:=hosted_vllm/${SERVED_MODEL_NAME}}"

# --- context -----------------------------------------------------------
: "${MAX_RESPONSE_LEN:=32768}"
: "${MAX_PROMPT_LEN:=$((VLLM_MAX_MODEL_LEN - MAX_RESPONSE_LEN))}"
: "${HARBOR_AGENT_MODEL_INFO:={max_input_tokens: ${MAX_PROMPT_LEN}, max_output_tokens: ${MAX_RESPONSE_LEN}, input_cost_per_token: 0, output_cost_per_token: 0\}}"

# --- logs --------------------------------------------------------------
: "${INFER_LOG_DIR:=${REPO_ROOT:?REPO_ROOT is required}/logs}"
: "${INFER_LOG_PREFIX:=infer_${PROJECT_NAME}_${EXP_NAME}}"
: "${INFER_LOG:=${INFER_LOG_DIR}/${INFER_LOG_PREFIX}.log}"
: "${VLLM_LOG:=${INFER_LOG_DIR}/${INFER_LOG_PREFIX}_vllm.log}"
