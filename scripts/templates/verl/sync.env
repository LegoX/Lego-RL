# module: verl/sync
# Verl-native defaults specific to sync Qwen3.5 VeOmni training.


# --- entry -------------------------------------------------------------
# Maps to the verl Hydra entry/config selection.
: "${VERL_ENTRY_MODULE:=verl.trainer.main_ppo}"
: "${VERL_CONFIG_NAME:=lego_rl_sync.yaml}"

# --- hybrid_engine ------------------------------------------------------
# Maps to actor_rollout_ref.hybrid_engine. Sync colocates actor and rollout on
# the same GPUs, which is exactly what hybrid_engine means; async splits them
# across dedicated nodes and sets False. hydra_args.sh reads this unconditionally
# under `set -u`, so leaving it undefined aborts the runner before launch.
: "${HYBRID_ENGINE:=True}"

# GPU_MEM_UTIL and TRAINER_NNODES also differ between the modes, but both are
# already defaulted in verl/common.env, which is sourced before this file — a
# `:=` here would be dead code. They are derived from TRAINING_MODE there.

: "${TRAIN_PROMPT_BSZ:=64}"
: "${VAL_BSZ:=500}"

