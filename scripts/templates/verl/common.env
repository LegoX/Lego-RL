# module: verl/common
# Verl-native train defaults shared by async/sync and VeOmni/FSDP train runs.
# Experiment-specific paths stay in model/data modules or the final experiment config.

# --- common ------------------------------------------------------------
: "${NCCL_TIMEOUT:=7200}"
: "${TRAIN_BSZ:=64}"
: "${TRAIN_MINI_BSZ:=64}"
: "${SP_SIZE:=8}"
: "${EP_SIZE:=1}"
: "${GEN_TP:=4}"

# --- data --------------------------------------------------------------
# Maps to data.*. File paths are supplied by data modules or experiment configs.
: "${TRAIN_FILES:?TRAIN_FILES is required}"
: "${VAL_FILES:?VAL_FILES is required}"
: "${MAX_PROMPT:=30000}"
: "${MAX_RESP:=170000}"
: "${PROMPT_KEY:=prompt}"
: "${DATA_TRUNCATION:=left}"
: "${RETURN_RAW_CHAT:=True}"

# --- routing_replay ----------------------------------------------------
# Maps to rollout.enable_rollout_routing_replay; engine-specific replay keys live
# in verl/veomni.env or verl/fsdp.env.
: "${ENABLE_R3:=True}"

# --- actor_rollout_ref.model -------------------------------------------------------------
# Maps to actor_rollout_ref.model.*.
: "${ENABLE_GRADIENT_CHECKPOINTING:=True}"
: "${ENABLE_ACTIVATION_OFFLOAD:=False}"
: "${FUSED_KERNELS:=False}"
: "${MODEL_PATH:?MODEL_PATH is required}"
: "${TOOL_CALL_PARSER:?TOOL_CALL_PARSER is required}"
: "${USE_REMOVE_PADDING:=True}"

# --- actor -------------------------------------------------------------
# Maps to actor_rollout_ref.actor.*.
: "${CLIP_HIGH:=4e-4}"
: "${CLIP_LOW:=3e-4}"
: "${ENTROPY_COEFF:=0.0}"
: "${KL_LOSS_COEF:=0.001}"
: "${KL_LOSS_TYPE:=low_var_kl}"
: "${LOSS_AGG_MODE:=seq-mean-token-mean}"
: "${POLICY_LOSS_MODE:=gspo}"
: "${ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU:=$(((MAX_PROMPT + MAX_RESP) / SP_SIZE))}"
: "${ACTOR_PPO_MICRO_BATCH_SIZE_PER_GPU:=1}"
: "${ACTOR_PPO_MINI_BATCH_SIZE:=${TRAIN_MINI_BSZ}}"
: "${USE_DYNAMIC_BSZ:=True}"
: "${USE_KL_LOSS:=True}"

# --- optim -------------------------------------------------------------
# Maps to actor_rollout_ref.actor.optim.*.
: "${ACTOR_LR:=1e-6}"
: "${LR_SCHEDULER:=constant}"

# --- rollout -----------------------------------------------------------
# Maps to actor_rollout_ref.rollout.* shared defaults. ROLLOUT_MODE=async here
# means the vLLM server-side rollout mode; both async and sync training scripts use it.
: "${AGENT_NUM_WORKERS:=128}"
: "${CALCULATE_LOG_PROBS:=True}"
: "${DISABLE_LOG_STATS:=False}"
: "${ENABLE_CHUNKED_PREFILL:=True}"
: "${ENABLE_ROLLOUT_ROUTING_REPLAY:=${ENABLE_R3:-True}}"
: "${ENABLE_SLEEP_MODE:=False}"
: "${ENFORCE_EAGER:=False}"
: "${GPU_MEM_UTIL:=0.85}"
: "${N_RESP:=8}"
: "${ROLLOUT_DTYPE:=bfloat16}"
: "${ROLLOUT_LOG_PROB_MAX_TOKEN_LEN_PER_GPU:=${ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU}}"
: "${ROLLOUT_LOG_PROB_MICRO_BATCH_SIZE_PER_GPU:=1}"
: "${ROLLOUT_LOG_PROB_USE_DYNAMIC_BSZ:=${USE_DYNAMIC_BSZ}}"
: "${ROLLOUT_MAX_MODEL_LEN:=$((MAX_PROMPT + MAX_RESP))}"
: "${ROLLOUT_MODE:=async}"
: "${SERVED_MODEL_NAME:=vllm_model}"
: "${ROLLOUT_NAME:=vllm}"
: "${TEMPERATURE:=1.0}"
: "${TOP_K:=-1}"
: "${TOP_P:=1.0}"

# --- rollout.val_kwargs -----------------------------------------------
# Maps to actor_rollout_ref.rollout.val_kwargs.* shared defaults.
: "${VAL_DO_SAMPLE:=True}"
: "${VAL_N:=1}"
: "${VAL_TEMPERATURE:=0.7}"
: "${VAL_TOP_K:=-1}"
: "${VAL_TOP_P:=1.0}"

# --- ref ---------------------------------------------------------------
# Maps to actor_rollout_ref.ref.*.
: "${REF_LOG_PROB_USE_DYNAMIC_BSZ:=${USE_DYNAMIC_BSZ}}"
: "${REF_LOG_PROB_MICRO_BATCH_SIZE_PER_GPU:=1}"
: "${REF_LOG_PROB_MAX_TOKEN_LEN_PER_GPU:=${ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU}}"

# --- algorithm ---------------------------------------------------------
# Maps to algorithm.*, algorithm.trajectory_filter.*, and
# algorithm.rollout_correction.*.
: "${ADV_ESTIMATOR:=grpo}"
: "${USE_KL_IN_REWARD:=False}"
: "${KL_COEF:=0.0}"
: "${ROLLOUT_CORRECTION_BYPASS:=False}"
: "${ROLLOUT_IS:=null}"
: "${ROLLOUT_IS_THRESHOLD:=2.0}"
: "${SEQ_DIST_METRICS:=True}"
: "${TRAJ_FILTER_ENABLE:=True}"
: "${TRAJ_FILTER_FILTER_OVERLONG:=False}"

# --- topology ----------------------------------------------------------
# Maps to top-level rollout.* and trainer topology keys.
: "${NGPUS_PER_NODE:=8}"
: "${ROLLOUT_N_GPUS_PER_NODE:=${NGPUS_PER_NODE}}"
: "${ROLLOUT_NNODES:=${N_NODES_ROLLOUT}}"
: "${TRAINER_N_GPUS_PER_NODE:=${NGPUS_PER_NODE}}"
: "${TRAINER_NNODES:=${N_NODES_TRAIN}}"

# --- exp ---------------------------------------------------------------
# Maps to trainer.* experiment identity, cadence, and log file defaults.
: "${TRAINER_EXPERIMENT_NAME:=${EXP_NAME}}"
: "${HARBOR_LOG_DIR:=${REPO_ROOT:?REPO_ROOT is required}/logs}"
: "${TRAINER_LOGGER:=['console', 'wandb']}"
: "${TRAINER_PROJECT_NAME:=${PROJECT_NAME}}"
: "${TRAINER_SAVE_FREQ:=10}"
: "${TRAINER_TEST_FREQ:=10}"
: "${TRAINER_TOTAL_EPOCHS:=${TOTAL_EPOCHS}}"
: "${TRAINER_VAL_BEFORE_TRAIN:=True}"
: "${TRAIN_LOG:=${HARBOR_LOG_DIR}/${TRAINER_EXPERIMENT_NAME}.log}"
: "${VLLM_LOG:=${HARBOR_LOG_DIR}/${TRAINER_EXPERIMENT_NAME}_vllm.log}"
: "${WANDB_API_KEY:=}"
