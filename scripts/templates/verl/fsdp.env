# module: verl/fsdp
# Verl-native defaults specific to the FSDP model engine.


# --- model_engine ------------------------------------------------------
# FSDP uses the base config groups directly; it does not pass model_engine=veomni.
: "${MODEL_ENGINE:=fsdp}"

# --- actor -------------------------------------------------------------
# Maps to actor_rollout_ref.actor.* and actor_rollout_ref.actor.fsdp_config.*.
: "${FSDP_STRATEGY:=fsdp}"
: "${FSDP_SIZE:=-1}"
: "${ACTOR_STRATEGY:=${FSDP_STRATEGY}}"
: "${ACTOR_FSDP_STRATEGY:=${FSDP_STRATEGY}}"
: "${ACTOR_FSDP_PARAM_OFFLOAD:=True}"
: "${ACTOR_FSDP_OPTIMIZER_OFFLOAD:=True}"

# --- ref ---------------------------------------------------------------
# Maps to actor_rollout_ref.ref.* and actor_rollout_ref.ref.fsdp_config.*.
: "${REF_STRATEGY:=${FSDP_STRATEGY}}"
: "${REF_FSDP_STRATEGY:=${FSDP_STRATEGY}}"
: "${REF_FSDP_PARAM_OFFLOAD:=True}"

# --- routing_replay ----------------------------------------------------
# Maps to actor_rollout_ref.actor.fsdp_config.router_replay.mode when ENABLE_R3=True.
: "${R3_FSDP_ROUTER_REPLAY_MODE:=R3}"
