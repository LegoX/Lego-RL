# module: verl/async
# Verl-native defaults specific to fully-async Qwen3.5 VeOmni training.

# Permit an explicit single-node async split when the trainer and rollout GPU
# requests fit within one Ray node. Set to 0 to restore strict node accounting.
: "${ALLOW_SINGLE_NODE_ASYNC_SPLIT:=1}"


# --- entry -------------------------------------------------------------
# Maps to the verl Hydra entry/config selection.
: "${VERL_ENTRY_MODULE:=verl.experimental.fully_async_policy.fully_async_main}"
: "${VERL_CONFIG_NAME:=lego_rl_fully_async_fsdp.yaml}"

# --- hybrid_engine ------------------------------------------------------
# Maps to actor_rollout_ref.hybrid_engine
: "${HYBRID_ENGINE:=False}"

: "${TRAIN_PROMPT_BSZ:=0}"
: "${GEN_PROMPT_BSZ:=1}"
: "${TOTAL_ROLLOUT_STEPS:=204800}"

# --- async_training ----------------------------------------------------
# Maps to the verl fully-async async_training.* config group.
: "${PARTIAL_ROLLOUT:=True}"
: "${REQUIRE_BATCHES:=1}"
: "${STALENESS:=1.0}"
: "${TRIGGER_PARAMETER_SYNC_STEP:=$((TRAIN_BSZ / (TRAIN_MINI_BSZ * REQUIRE_BATCHES)))}"
: "${VALIDATION_ROLLOUT_MIN_IDLE_WORKERS:=8}"
