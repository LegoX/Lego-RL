# module: verl/veomni
# Verl-native defaults specific to the VeOmni model engine.


# --- model_engine ------------------------------------------------------
# Maps to model_engine=veomni.
: "${MODEL_ENGINE:=veomni}"

# --- actor -------------------------------------------------------------
# Maps to actor_rollout_ref.actor.veomni.*.
: "${ACTOR_VEOMNI_PARAM_OFFLOAD:=True}"
: "${ACTOR_VEOMNI_OPTIMIZER_OFFLOAD:=True}"
: "${ACTOR_VEOMNI_ENABLE_FULL_SHARD:=True}"
: "${ACTOR_VEOMNI_FSDP_SIZE:=-1}"
: "${ACTOR_VEOMNI_ENTROPY_FROM_LOGITS_WITH_CHUNKING:=True}"
: "${ACTOR_VEOMNI_ENTROPY_CHECKPOINTING:=True}"
: "${ACTOR_VEOMNI_ULYSSES_PARALLEL_SIZE:=${SP_SIZE}}"
: "${ACTOR_VEOMNI_EXPERT_PARALLEL_SIZE:=${EP_SIZE}}"

# --- ref ---------------------------------------------------------------
# Maps to actor_rollout_ref.ref.veomni.*.
: "${REF_VEOMNI_PARAM_OFFLOAD:=True}"

# --- routing_replay ----------------------------------------------------
# Maps to actor_rollout_ref.actor.veomni.router_replay.mode when ENABLE_R3=True.
: "${R3_VEOMNI_ROUTER_REPLAY_MODE:=R3}"
