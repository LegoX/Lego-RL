# module: backend/k8s
# Kubernetes Harbor sandbox backend defaults mirrored from fully_async_3nodes_qwen35_ohsdk_veomni.sh.
# Site-specific values can still override these before or after sourcing this template.
: "${HARBOR_ENVIRONMENT_IMPORT_PATH:=harbor_patch.environments.kubernetes.kubernetes:KubernetesEnvironment}"
: "${HARBOR_ENVIRONMENT_TYPE:=null}"
: "${HARBOR_ENVIRONMENT_MEMORY_LIMIT_FACTOR:=4}"
: "${HARBOR_HOSTPATH_MOUNTS:=}"
: "${HARBOR_HOSTPATH_NODE_REWRITE:=}"
: "${HARBOR_K8S_INLINE_BUILD:=false}"
: "${HARBOR_NYDUS_MIRROR:=}"
: "${HARBOR_OPENSWE_BASE_REGISTRY:=}"
: "${HARBOR_OPENSWE_IMAGE_REGISTRY:=}"
: "${HARBOR_OPENSWE_SKIP_DOCKERFILE:=true}"
: "${K8S_KUBECONFIG:?K8S_KUBECONFIG is required}"
: "${K8S_NAMESPACE:=default}"
: "${K8S_POD_ACTIVE_DEADLINE_SECONDS:=6000}"
: "${K8S_POD_STARTUP_TIMEOUT:=1200}"
: "${K8S_VAL_POD_ACTIVE_DEADLINE_SECONDS:=9000}"
: "${K8S_VAL_POD_STARTUP_TIMEOUT:=2400}"
: "${KUBECONFIG:=${K8S_KUBECONFIG}}"
