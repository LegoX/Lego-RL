# module: harbor/subagents
# First in TEMPLATE_MODULES; combine with harbor/compaction.env when needed.
: "${HARBOR_TRAIN_SUBAGENTS:=1}"
: "${HARBOR_TRAJECTORY_SELECTION:=all}"
: "${VERL_AGENT_FULL_SEQUENCE_TRAINING:=1}"
# Expose OHSDK TaskToolSet as well as capturing its trajectories.
: "${HARBOR_OPENHANDS_ENABLE_SUBAGENT:=1}"
export HARBOR_TRAIN_SUBAGENTS HARBOR_TRAJECTORY_SELECTION \
       VERL_AGENT_FULL_SEQUENCE_TRAINING HARBOR_OPENHANDS_ENABLE_SUBAGENT
