# module: harbor/multiturn
# Place before harbor/common.env and verl/common.env. The user model stays external to the policy.
: "${HARBOR_MULTITURN_ENABLED:=true}"
: "${HARBOR_MULTITURN_REWARD_MODE:=terminal}"
: "${HARBOR_MULTITURN_JUDGE_ENABLED:=false}"
: "${HARBOR_MULTITURN_TEST_WEIGHT:=1.0}"
: "${HARBOR_MULTITURN_JUDGE_WEIGHT:=0.0}"
: "${HARBOR_MULTITURN_MAX_ROUNDS:=5}"
: "${HARBOR_TRAJECTORY_SELECTION:=all}"
: "${VERL_AGENT_FULL_SEQUENCE_TRAINING:=1}"
: "${CROSS_SEGMENT_GAE:=True}"
: "${CROSS_SEGMENT_LAM_MODE:=trial}"
export HARBOR_MULTITURN_ENABLED HARBOR_MULTITURN_REWARD_MODE HARBOR_MULTITURN_MAX_ROUNDS \
       HARBOR_TRAJECTORY_SELECTION VERL_AGENT_FULL_SEQUENCE_TRAINING
