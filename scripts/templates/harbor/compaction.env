# module: harbor/compaction
# Put this before scaffold/verl defaults in TEMPLATE_MODULES.
: "${HARBOR_CONTEXT_BUDGET_TOKENS:=96000}"
: "${HARBOR_COMPACTION_MAX:=3}"
: "${HARBOR_TRIAL_GEN_TOKEN_BUDGET:=128000}"
: "${HARBOR_COMPACTION_TRAIN_SUMMARY:=1}"
: "${HARBOR_TRAJECTORY_SELECTION:=all}"
: "${VERL_AGENT_FULL_SEQUENCE_TRAINING:=1}"
export HARBOR_CONTEXT_BUDGET_TOKENS HARBOR_COMPACTION_MAX \
       HARBOR_TRIAL_GEN_TOKEN_BUDGET HARBOR_COMPACTION_TRAIN_SUMMARY \
       HARBOR_TRAJECTORY_SELECTION VERL_AGENT_FULL_SEQUENCE_TRAINING
