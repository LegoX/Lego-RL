# module: harbor/common
# Common Harbor agent, trial, validation, and environment resource defaults.
: "${HARBOR_AGENT_DISABLE_TOOL_CALLS:=False}"
: "${HARBOR_AGENT_MAX_ITERATIONS:=200}"
: "${HARBOR_AGENT_MAX_TIMEOUT_SEC:=2400}"
: "${HARBOR_AGENT_MODEL_INFO:={input_cost_per_token: 0, output_cost_per_token: 0\}}"
: "${HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC:=2400}"
: "${HARBOR_AGENT_SETUP_TIMEOUT_MULTIPLIER:=5.0}"
: "${HARBOR_AGENT_TEMPERATURE:=${TEMPERATURE:-1.0}}"
: "${HARBOR_AGENT_TIMEOUT_MULTIPLIER:=1.0}"
: "${HARBOR_ENV_START_MAX_ATTEMPTS:=1}"
: "${HARBOR_ENVIRONMENT_BUILD_TIMEOUT_MULTIPLIER:=1.0}"
: "${HARBOR_ENVIRONMENT_DELETE:=True}"
: "${HARBOR_ENVIRONMENT_FORCE_BUILD:=False}"
: "${HARBOR_ENVIRONMENT_OVERRIDE_CPUS:=1}"
: "${HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB:=8192}"
: "${HARBOR_MAX_CONSECUTIVE_NO_TOOL:=3}"
: "${HARBOR_MAX_RETRIES:=2}"
: "${HARBOR_POD_NAME_PREFIX:=harbor}"
: "${HARBOR_TRIALS_DIR:=${REPO_ROOT:-.}/harbor_trials/${PROJECT_NAME:-project}/${EXP_NAME:-${EXP_TAG:-exp}}}"
: "${HARBOR_VAL_AGENT_MAX_TIMEOUT_SEC:=4800}"
: "${HARBOR_VAL_MAX_RETRIES:=2}"
: "${HARBOR_VERIFIER_ENABLED:=True}"
: "${HARBOR_VERIFIER_TIMEOUT_MULTIPLIER:=1.0}"
