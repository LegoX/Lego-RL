#!/usr/bin/env bash
# lib/site.example.env — "cluster infra" config template. **To run on a different cluster, cp to site.env first, then edit here.**
#   cp scripts/lib/site.example.env scripts/lib/site.env   then change the values below for your cluster.
# common_env.sh auto-sources lib/site.env (this .example file is not sourced).
#
# Why a separate layer: many things in the training scripts are specific to "my cluster" — prebuilt-image registry, nydus image,
# hostPath mounts, kubeconfig, docker daemon, model/code root dirs. Most other clusters don't have these.
# All left empty = portable vanilla path (in-pod inline-build, no special mounts, no image rewrite), slow but runs everywhere;
# fill in your values = enable the corresponding acceleration. No cluster address is hardcoded in runner/lib anymore.

# ── storage / code roots (required: point to your models and verl worktree) ──
export MODEL_ROOT="${MODEL_ROOT:-/path/to/your/models}"        # model_presets uses $MODEL_ROOT/<model-name>
export NEW_VERL_DIR="${NEW_VERL_DIR:-/path/to/verl-swe_agent_opd_dev}"  # where veomni/R3/async fixes live (required when USE_NEW_VERL=1)

# ── k8s (required for k8s backend) ──
export K8S_KUBECONFIG="${K8S_KUBECONFIG:-$HOME/.kube/config}"

# ── acceleration 1: prebuilt-image registry (optional) ──
# Yes: prebuild per-instance images and push to a registry; pods pull directly at training time, instant start, skip Dockerfile rebuild.
# No: leave empty → use inline-build (build in-pod per-task from Dockerfile, generic but reinstalls deps every trial, slow).
# ⚠ If filled, each cluster node's containerd must configure that registry as insecure (certs.d/hosts.toml).
export HARBOR_OPENSWE_IMAGE_REGISTRY="${HARBOR_OPENSWE_IMAGE_REGISTRY:-}"

# ── acceleration 2: val official swebench image rewrite (optional) ──
# If the val set is official SWE-bench (task.toml hardcodes docker.io/swebench/...) and your pods have no Docker Hub egress,
# mirror the images to a local registry first and put that registry here → harbor rewrites automatically; else all val ImagePull fails = reward0.
export HARBOR_NYDUS_MIRROR="${HARBOR_NYDUS_MIRROR:-}"

# ── offline mounts: hostPath (optional) ──
# If your validation/grading depends on offline data on the node (e.g. SWE-rebench log parser, grading toolchain), mount it into the pod here.
# None → null (no mounts). Format: JSON list of {host_path, mount_path, read_only}.
# Example (this cluster):
#   _SITE_HPM='[{"host_path":"/path/to/node-local/rebench-data","mount_path":"/opt/rebench-v2","read_only":true}]'
#   export HARBOR_HOSTPATH_MOUNTS="${HARBOR_HOSTPATH_MOUNTS:-$_SITE_HPM}"
export HARBOR_HOSTPATH_MOUNTS="${HARBOR_HOSTPATH_MOUNTS:-null}"

# ── docker backend remote daemon (only used when BACKEND=docker) ──
export DOCKER_HOST="${DOCKER_HOST:-tcp://YOUR_DOCKER_HOST:2375}"

# ── agent runtime image registry (optional) ──
# Each scaffold's runtime image defaults to docker.io/jierun/.... If your cluster can't pull it, mirror to your registry first,
# then override HARBOR_AGENT_RUNTIME_IMAGE=<your registry>/c-oh-sdk-1.33.0:v0.1 in config/command-line.
